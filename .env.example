# ╔══════════════════════════════════════════════════════════════╗
# ║  ORCHESTRIX — Environment configuration                      ║
# ║  Copier ce fichier en .env et remplir les valeurs réelles.   ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Application ──────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── API ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ── PostgreSQL + pgvector ───────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orchestrix
POSTGRES_USER=orchestrix
POSTGRES_PASSWORD=orchestrix_dev
DATABASE_URL=postgresql+asyncpg://orchestrix:orchestrix_dev@localhost:5432/orchestrix

# ── Redis (cache, queues) ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── MLflow ───────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=./mlartifacts
MLFLOW_EXPERIMENT_NAME=orchestrix-dev

# ── LLM Provider ────────────────────────────────────────────────
# Provider actif: "ollama" | "vllm" | "openai"
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b

# Fallback cloud (optionnel)
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_API_KEY=sk-replace-with-your-key
LLM_FALLBACK_MODEL=gpt-4o-mini

# ── Embeddings ──────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Jira Cloud ──────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token-here
JIRA_PROJECT_KEY=PROJ
JIRA_DEMO_PROJECT_KEY=DEMO

# ── Observabilité ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Evaluation gate (CI) ───────────────────────────────────────
EVAL_GATE_MAX_UNSAFE_ACTION_RATE_INCREASE=0.05
EVAL_GATE_MIN_TASK_SUCCESS=0.80
EVAL_GATE_MAX_FALSE_BLOCK_RATE=0.10

# ── ActionGuard ─────────────────────────────────────────────────
ACTIONGUARD_HUMAN_REVIEW_THRESHOLD=0.5
ACTIONGUARD_MAX_DAILY_ACTIONS_PER_USER=20
ACTIONGUARD_MAX_ASSIGNED_HOURS_PER_WEEK=40

# Copiez ce fichier en « .env », remplissez, puis : docker compose up --build
#   cp .env.exemple .env

# Obligatoire pour générer des plans.
GROQ_API_KEY=gsk_...

# Facultatif mais recommandé : sans jeton, GitHub plafonne à 10 recherches/heure.
GITHUB_TOKEN=
GITLAB_TOKEN=

# Longueur maximale du plan (16000 par défaut). Plus court = plus rapide.
MAX_TOKENS_PLAN=16000

# Nombre de preuves traduites avant l'affichage.
PREUVES_TRADUITES_IMMEDIAT=12

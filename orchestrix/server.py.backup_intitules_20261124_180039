    $("#jMessage").innerHTML = `<span class="ok-txt">${d.crees.length} ticket(s) créé(s)${
      d.erreurs.length ? " · " + d.erreurs.length + " erreur(s)" : ""}.</span>`;
  } catch(e){ $("#jMessage").innerHTML = `<span class="ko-txt">${esc(e.message)}</span>`; }
}

async function jiraRelire(){
  $("#jMessage").innerHTML = `<span class="vide">Relecture…</span>`;
  try {
    const d = await API.poster("/api/jira/relire", {});
    adopter(d);
    $("#jMessage").innerHTML = `<span class="ok-txt">${d.changements} changement(s) rapatrié(s).</span>`;
  } catch(e){ $("#jMessage").innerHTML = `<span class="ko-txt">${esc(e.message)}</span>`; }
}

/* créer le projet depuis le plan affiché */
async function creerProjet(){
  try {
    const d = await API.poster("/api/projet/creer", {nom: $("#nomProjet").value || ""});
    adopter(d);
    aller("espace");
    if(!(d.projet.equipe || []).length) setTimeout(ouvrirEquipe, 350);
  } catch(e){ alert("Erreur : " + e.message); }
}

/* ── validation humaine du plan ──────────────────────────────────── */
const VALID_LIB = {aucune:"Non soumis", en_attente:"En attente de validation",
                   approuve:"Approuvé", rejete:"Rejeté"};

function rendreValidation(){
  const zone = $("#bandeauValidation");
  if(!zone) return;
  const v = (PROJET && PROJET.validation) || {statut:"aucune"};
  const st = v.statut || "aucune";
  const icone = st === "approuve" ? ICO.ok : st === "rejete" ? ICO.ko
              : st === "en_attente" ? ICO.alerte : ICO.doc;
  const classe = st === "approuve" ? "ok" : st === "rejete" ? "ko"
               : st === "en_attente" ? "atteinte" : "";
  const textes = {
    aucune: ["Le plan n'est pas encore soumis",
             "Un plan validé par un humain peut seul passer en exécution. Soumettez-le pour décision."],
    en_attente: ["En attente de votre décision",
             "Approuvez pour démarrer l'exécution, ou rejetez en expliquant ce qui ne va pas : un nouveau plan sera généré."],
    approuve: ["Plan approuvé le " + (v.date || "—") + " par " + (v.auteur || "le chef de projet"),
             "L'exécution est ouverte : vous pouvez affecter les tâches et les suivre."],
    rejete: ["Plan rejeté le " + (v.date || "—"),
             "Motif : " + (v.motif || "—")]
  }[st] || ["", ""];

  const actions = [];
  if(st === "aucune" || st === "rejete"){
    actions.push(`<button class="btn btn-p" onclick="soumettrePlan()">
      Soumettre à validation</button>`);
    actions.push(`<button class="btn btn-s" onclick="approuverDirect()">Approuver directement</button>`);
    actions.push(`<button class="btn btn-f" onclick="basculerMotif()">Rejeter et régénérer</button>`);
  } else if(st === "en_attente"){
    actions.push(`<button class="btn btn-p" onclick="approuverDirect()">Approuver le plan</button>`);
    actions.push(`<button class="btn btn-s" onclick="basculerMotif()">Rejeter et régénérer</button>`);
  } else {
    actions.push(`<a class="lien-page" onclick="aller('execution')">Aller à l'exécution</a>`);
    actions.push(`<button class="btn btn-f" onclick="ouvrirEquipe()">Composer l'équipe</button>`);
  }

  zone.innerHTML = `<div class="bandeau-validation ${classe}">
    <span class="pastille-v">${icone}</span>
    <span class="txt-v"><b>${esc(VALID_LIB[st] || st)}</b>
      <span>${esc(textes[0])}</span>
      ${textes[1] ? `<span style="display:block;margin-top:2px">${esc(textes[1])}</span>` : ""}
    </span>
    <span class="actions-v">${actions.join("")}</span>
    <div class="zone-motif cache" id="zoneMotif">
      <textarea id="motifRejet" placeholder="Expliquez ce qui ne va pas dans ce plan (10 caractères minimum). Exemple : trop de tâches de documentation, il manque la gestion des rôles et la partie facturation."></textarea>
      <div style="display:flex;gap:8px;margin-top:8px;justify-content:flex-end">
        <button class="btn btn-f" onclick="basculerMotif()">Annuler</button>
        <button class="btn btn-p" onclick="rejeterPlan()">Rejeter et générer un nouveau plan</button>
      </div>
    </div>
  </div>`;
}

function basculerMotif(){
  const z = $("#zoneMotif");
  if(z){ z.classList.toggle("cache"); if(!z.classList.contains("cache")) $("#motifRejet").focus(); }
}

async function soumettrePlan(){
  try { adopter(await API.poster("/api/projet/soumettre", {})); }
  catch(e){ alert("Erreur : " + e.message); }
}

async function approuverDirect(){
  try { adopter(await API.poster("/api/projet/approuver", {})); }
  catch(e){ alert("Erreur : " + e.message); }
}

async function rejeterPlan(){
  const motif = ($("#motifRejet").value || "").trim();
  if(motif.length < 10){
    alert("Expliquez le rejet en une phrase (10 caractères minimum) : c'est ce texte qui guidera le nouveau plan.");
    $("#motifRejet").focus();
    return;
  }
  try {
    adopter(await API.poster("/api/projet/rejeter", {motif}));
    /* le motif part avec la demande de génération : le modèle le reçoit */
    await lancerRegeneration(motif);
  } catch(e){ alert("Erreur : " + e.message); }
}

async function lancerRegeneration(motif){
  appelErreur("");
  $("#attente").classList.remove("cache");
  reinitialiserAttente();
  aller("saisie");
  try {
    await API.poster("/api/generer", {motif});
    const t0 = Date.now();
    MINUTEUR = setInterval(() => {
      fetch("/api/etat").then(r => r.json()).then(e => {
        majAttente(e, t0);
        if(e.statut === "termine"){
          arreter();
          charger().then(() => { if(typeof aller === "function") aller("plan"); });
        } else if(e.statut === "erreur"){
          arreter();
          appelErreur(e.erreur || "la génération a échoué");
        } else if(e.statut === "traduction" && e.pret && !PLAN_AFFICHE){
          PLAN_AFFICHE = true;
          masquerAttente();
          charger().then(() => { if(typeof aller === "function") aller("plan"); });
        }
      }).catch(() => {});
    }, 1200);
  } catch(e){
    $("#attente").classList.add("cache");
    appelErreur("Régénération impossible : " + e.message);
  }
}

function appelErreur(msg){
  const z = $("#zoneErreur");
  if(!z) return;
  z.innerHTML = msg ? `<div class="alerte erreur">${ICO.alerte}
    <div><b>${esc(msg)}</b></div></div>` : "";
}

/* ── mode présentation ───────────────────────────────────────────── */
function basculerPresentation(){
  document.body.classList.toggle("presentation");
  const b = $("#btnPresentation");
  if(b) b.textContent = document.body.classList.contains("presentation")
    ? "Quitter la présentation" : "Mode présentation";
}

/* ── réglages : clé du modèle ────────────────────────────────────── */
async function chargerReglages(){
  try {
    const d = await API.lire("/api/reglages");
    const b = $("#bCle");
    if(b){
      b.textContent = d.cle_presente ? "ok" : "";
      b.style.background = d.cle_presente ? "rgba(45,212,191,.22)" : "rgba(225,29,72,.26)";
      b.style.color = d.cle_presente ? "#99f6e4" : "#fecdd3";
    }
    $("#etatCle").innerHTML = d.cle_presente
      ? `<span class="etat-jira ok"><i></i>Clé présente (${esc(d.source)})</span>`
      : `<span class="etat-jira non"><i></i>Aucune clé</span>`;
    $("#modeleDetecte").innerHTML = d.modele
      ? `<div class="l">Modèle retenu<b>${esc(d.modele)}</b></div>`
      : (d.erreur ? `<div class="l"><span class="ko-txt">${esc(d.erreur)}</span></div>` : "");
  } catch(e) { /* serveur sans gestion de clé */ }
}

async function enregistrerCle(){
  const cle = ($("#champCle").value || "").trim();
  if(!cle){ $("#messageCle").innerHTML = `<span class="ko-txt">Saisissez une clé.</span>`; return; }
  try {
    await API.poster("/api/reglages", {cle});
    $("#champCle").value = "";
    $("#messageCle").innerHTML = `<span class="ok-txt">Clé enregistrée.</span>`;
    chargerReglages(); majRappelCle();
  } catch(e) { $("#messageCle").innerHTML = `<span class="ko-txt">${esc(e.message)}</span>`; }
}

async function testerCle(){
  $("#messageCle").innerHTML = `<span class="vide">Test en cours…</span>`;
  try {
    const d = await API.poster("/api/reglages/tester", {});
    $("#messageCle").innerHTML = `<span class="ok-txt">Clé valide — modèle « ${esc(d.modele)} ».</span>`;
    chargerReglages();
  } catch(e) { $("#messageCle").innerHTML = `<span class="ko-txt">${esc(e.message)}</span>`; }
}

async function effacerCle(){
  if(!confirm("Effacer la clé enregistrée sur cette machine ?")) return;
  try {
    await API.poster("/api/reglages", {effacer: true});
    $("#messageCle").innerHTML = `<span class="ok-txt">Clé effacée.</span>`;
    chargerReglages(); majRappelCle();
  } catch(e) { $("#messageCle").innerHTML = `<span class="ko-txt">${esc(e.message)}</span>`; }
}

/* rappel sur l'écran de saisie quand la clé manque */
function majRappelCle(){
  const zone = $("#rappelCle");
  if(!zone) return;
  fetch("/api/reglages").then(r => r.json()).then(d => {
    zone.innerHTML = d.cle_presente ? "" : `
      <div class="alerte avert" style="margin-top:16px">
        ${ICO.alerte}<div><b>Clé Groq absente</b>
        La génération ne peut pas démarrer. Ajoutez votre clé dans
        <a href="#" onclick="aller('reglages');return false">Réglages</a>
        — elle reste sur votre machine.</div></div>`;
  }).catch(() => {});
}

/* ── démarrage ───────────────────────────────────────────────────── */
/* le démarrage ne doit jamais bloquer le rendu si le réseau manque */
if(typeof fetch === "function"){
  try { chargerProjet(); } catch(e){}
  try { chargerReglages(); } catch(e){}
  try { majRappelCle(); } catch(e){}
}


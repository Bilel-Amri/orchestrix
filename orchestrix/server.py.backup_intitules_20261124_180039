function trouverTache(cle){
  for(const e of (PLAN.epics || [])){
    for(const s of (e.stories || [])){
      for(const t of (s.tasks || [])){
        if(String(t.cle) === String(cle)) return {t, s, e};
      }
    }
  }
  return null;
}

function fermerPanneau(){
  const p = $("#panneau"); if(p) p.remove();
  const v = $("#voile"); if(v) v.remove();
}


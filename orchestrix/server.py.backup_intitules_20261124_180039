    <div class="prop"><dt>Énoncés bruts</dt><dd>${nf((META.pipeline || {}).fonctions_brutes)}</dd></div>
    <div class="prop"><dt>Épics</dt><dd>${nf(q.epics)}</dd></div>
    <div class="prop"><dt>Documents</dt><dd>${nf((META.pipeline || {}).documents)}</dd></div>`;

  const sansCriteres = (PLAN.epics || []).flatMap(e => e.stories || [])
    .filter(s => !(s.acceptance || []).length).length;
  const sansDesc = taches.filter(x => !String(x.t.description || "").trim()).length;
  const verifs = [
    ["Chaque tâche renvoie à une preuve", `${nf(taches.length - sans.length)} / ${nf(taches.length)}`, sans.length === 0],

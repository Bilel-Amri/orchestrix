  const okN = verifs.filter(v => v[2]).length;
  $("#noteVerifs").textContent = `${okN} sur ${verifs.length} satisfaites`;
  $("#controles").innerHTML = verifs.map(([t, d, ok]) => `
    <div class="controle">
      <span class="pico ${ok ? "ok" : "ko"}">${ok ? ICO.ok : ICO.ko}</span>
      <span class="txt"><b>${esc(t)}</b><span>${esc(d)}</span></span>

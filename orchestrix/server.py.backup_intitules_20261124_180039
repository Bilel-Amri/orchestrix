     `${nf(((PLAN.epics || []).flatMap(e => e.stories || []).length) - sansCriteres)} story(s) complètes`, sansCriteres === 0],
    ["Chaque tâche est décrite", `${nf(taches.length - sansDesc)} / ${nf(taches.length)}`, sansDesc === 0],
    ["Chaque story est rattachée à un épic", `${nf((PLAN.epics || []).length)} épic(s)`, (PLAN.epics || []).length > 0],

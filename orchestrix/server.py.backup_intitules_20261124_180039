/* ══════════════════════════════════════════════════════════════════════
   PLANIFICATION
   ══════════════════════════════════════════════════════════════════════ */
const PRIO_RANG = {Haute:0, Moyenne:1, Basse:2};
const JOURS_SPRINT = 10;

function tachesOrdonnees(){
  return toutesLesTaches()
    .map((x, i) => Object.assign({}, x, {ordre:i}))
    .sort((a, b) => (a.iEpic - b.iEpic)
      || ((PRIO_RANG[a.t.priorite] ?? 1) - (PRIO_RANG[b.t.priorite] ?? 1))
      || (a.ordre - b.ordre));
}

function repartirEnSprints(maxTaches, imposes){
  const t = tachesOrdonnees();
  const total = t.length;
  if(!total) return {sprints:[], total:0};

  let sprints = [];

  if(imposes > 0){
    const nombre = Math.min(imposes, total);
    sprints = Array.from({length:nombre}, () => []);
    t.forEach((x, i) => {
      const index = Math.min(nombre - 1, Math.floor(i * nombre / total));
      sprints[index].push(x);
    });
  } else {
    const limite = Math.max(1, maxTaches);
    for(let i = 0; i < total; i += limite){
      sprints.push(t.slice(i, i + limite));
    }
  }

  return {
    sprints: sprints.map(taches => ({taches})),
    total
  };
}

function rendrePlanification(){
  const maxTaches = Number(($("#cap") || {}).value) || 10;
  const imp = Number(($("#nbSprints") || {}).value) || 0;
  const {sprints, total} = repartirEnSprints(maxTaches, imp);
  const n = sprints.length;

  if(!n){
    $("#gantt").innerHTML = `<p class="vide">Aucune tâche à planifier.</p>`;
    $("#kpiPlanif").innerHTML = "";
    $("#sprints").innerHTML = "";
    $("#courbe").innerHTML = "";
    $("#noteCourbe").textContent = "";
    return;
  }

  const totalJours = n * JOURS_SPRINT;
  const base = new Date((META.date || "").replace(" ", "T"));
  const depart = isNaN(base.getTime()) ? new Date() : base;
  const fin = new Date(depart.getTime() + totalJours * 864e5);

  $("#kpiPlanif").innerHTML = [
    [n, "Sprints", "de " + JOURS_SPRINT + " jours ouvrés", "p-acc"],
    [Math.max(...sprints.map(s => s.taches.length)), "Tâches maximum",
      "dans un sprint", "p-acc"],
    [total, "Tâches à planifier", "total du projet", "p-warn"],
    [totalJours, "Jours ouvrés", "durée prévisionnelle", "p-neu"],
    [fin.toLocaleDateString("fr-FR", {day:"2-digit", month:"short", year:"numeric"}),
      "Fin prévisionnelle", "selon le découpage retenu", "p-ok"]
  ].map(([v, l, s, c]) => `
    <div class="kpi"><div class="haut">
      <div class="v">${typeof v === "number" ? nf(v) : esc(v)}</div>
      <div class="puce ${c}">${ICO.epic}</div></div>
      <div class="l">${esc(l)}</div><div class="s">${esc(s)}</div></div>`).join("");

  /* Diagramme de Gantt : nombre de tâches par épic et par sprint */
  const epics = PLAN.epics || [];
  $("#gantt").innerHTML = epics.map((e, i) => {
    const segments = sprints.map((s, k) => {
      const nombre = s.taches.filter(x => x.iEpic === i).length;
      return {k, nombre};
    }).filter(x => x.nombre > 0);

    if(!segments.length) return "";

    const debut = segments[0].k;
    const finS = segments[segments.length - 1].k;
    const gauche = debut / n * 100;
    const largeur = (finS - debut + 1) / n * 100;
    const nbTaches = segments.reduce((z, x) => z + x.nombre, 0);
    const teinte = ["#0f62fe", "#6929c4", "#007d79",
      "#1192e8", "#8b95a3", "#333c4a"][i % 6];

    return `<div class="gantt-l">
      <div class="n">${esc(e.title)}
        <em>${nf(nbTaches)} tâche${nbTaches > 1 ? "s" : ""} ·
        ${Math.round(nbTaches / total * 100)} %</em></div>
      <div class="gantt-piste"><div class="gantt-bloc"
        style="left:${gauche.toFixed(2)}%;width:${largeur.toFixed(2)}%;background:${teinte}"
        title="Sprints ${debut + 1} à ${finS + 1}">
        ${nf(nbTaches)} tâche${nbTaches > 1 ? "s" : ""}
      </div></div>
    </div>`;
  }).join("") + `<div class="axe">
    ${sprints.map((s, k) => `<span>S${k + 1}</span>`).join("")}</div>`;

  /* Cartes de sprint */
  $("#sprints").innerHTML = sprints.map((s, k) => {
    const titres = s.taches.slice(0, 4);
    const nombre = s.taches.length;

    return `<div class="sprint">
      <div class="sh"><b>Sprint ${k + 1}</b>
        <span>${nf(nombre)} tâche${nombre > 1 ? "s" : ""}</span></div>
      ${titres.map(x => `<div class="li"><code>${esc(x.t.cle)}</code>
        <span title="${esc(x.t.title)}">${esc(x.t.title)}</span></div>`).join("")}
      ${nombre > 4 ? `<div class="plus">+ ${nombre - 4} autre${nombre - 4 > 1 ? "s" : ""}</div>` : ""}
      <div class="barre-s"><i style="width:${(nombre / Math.max(1, total) * 100).toFixed(0)}%"></i></div>
    </div>`;
  }).join("");

  /* Courbe cumulative du nombre de tâches */
  let cumul = 0;
  const points = sprints.map((s, k) => {
    cumul += s.taches.length;
    return {x:k, y:cumul};
  });

  const W = 520, H = 128, marge = 26;
  const px = k => marge + (n === 1 ? (W - 2 * marge) / 2
    : k / (n - 1) * (W - 2 * marge));
  const py = v => H - 18 - (v / Math.max(1, total)) * (H - 34);
  const trace = points.map(p =>
    `${px(p.x).toFixed(1)},${py(p.y).toFixed(1)}`).join(" ");
  const aire = `${marge},${H - 18} ${trace} ${px(n - 1).toFixed(1)},${H - 18}`;

  $("#courbe").innerHTML = `<svg class="courbe" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">
    <defs><linearGradient id="gAire" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0f62fe" stop-opacity=".14"/>
      <stop offset="1" stop-color="#0f62fe" stop-opacity="0"/></linearGradient></defs>
    <line x1="${marge}" y1="${H - 18}" x2="${W - marge}" y2="${H - 18}"
      stroke="#e3e6eb" stroke-width="1"/>
    <line x1="${marge}" y1="${py(total).toFixed(1)}"
      x2="${W - marge}" y2="${py(total).toFixed(1)}"
      stroke="#d0d5dd" stroke-width="1" stroke-dasharray="4 4"/>
    <text x="${marge + 2}" y="${py(total) - 5}" font-size="9.5" fill="#98a2b3">
      cible ${nf(total)} tâches</text>
    <polygon points="${aire}" fill="url(#gAire)"/>
    <polyline points="${trace}" fill="none" stroke="#0f62fe" stroke-width="2"
      stroke-linejoin="round" stroke-linecap="round"/>
    ${points.map(p => `<circle cx="${px(p.x).toFixed(1)}"
      cy="${py(p.y).toFixed(1)}" r="3.4" fill="#ffffff"
      stroke="#0f62fe" stroke-width="2"/>`).join("")}
    ${points.map((p, k) => `<text x="${px(p.x).toFixed(1)}" y="${H - 5}"
      font-size="9" fill="#98a2b3" text-anchor="middle">S${k + 1}</text>`).join("")}
  </svg>`;

  $("#noteCourbe").textContent = `${n} sprints · ${nf(total)} tâches`;
}

/* ══════════════════════════════════════════════════════════════════════
   RISQUES ET HYPOTHÈSES
   ══════════════════════════════════════════════════════════════════════ */
function construireRisques(){
  const taches = toutesLesTaches();
  const stories = (PLAN.epics || []).flatMap(e => e.stories || []);
  const sans = taches.filter(x => !(x.t.sources || []).length);
  const sansCrit = stories.filter(s => !(s.acceptance || []).length);
  const hautes = taches.filter(x => x.t.priorite === "Haute");
  const tresElevees = taches.filter(
    x => x.t.complexite_classe === "Tres_elevee"
  );
  const secu = taches.filter(x => x.t.type === "securite").length;
  const tests = taches.filter(x => x.t.type === "test").length;
  const doc = taches.filter(x => x.t.type === "doc").length;
  const R = [];

  if(sans.length) R.push({
    titre: `${sans.length} tâche${sans.length > 1 ? "s" : ""} sans preuve attachée`,
    description: "Ces tâches reposent sur une déduction de l'agent et non sur un extrait de source. À faire valider par le métier avant engagement.",
    prob:2, impact:2, mesure:`Revoir ${Math.min(sans.length, 5)} tâche(s) en priorité`});
  if(!secu) R.push({
    titre: "Aucune tâche de sécurité identifiée",
    description: "Le plan ne comporte pas de volet sécurité : authentification, droits d'accès et journalisation ne sont pas couverts.",
    prob:3, impact:3, mesure:"Ajouter un lot sécurité et un test d'intrusion"});
  else if(secu < Math.max(2, Math.round(taches.length * 0.06))) R.push({
    titre: "Volet sécurité léger",
    description: `Seulement ${secu} tâche(s) de sécurité pour ${taches.length} tâches au total.`,
    prob:2, impact:3, mesure:"Renforcer le lot sécurité avant la mise en production"});
  if(tests < Math.max(2, Math.round(taches.length * 0.1))) R.push({
    titre: "Couverture de test insuffisante",
    description: `${tests} tâche(s) de test pour ${taches.length} tâches. Le risque de régression augmente à chaque incrément.`,
    prob:2, impact:2, mesure:"Viser au moins une tâche de test par story"});
  if(!doc) R.push({
    titre: "Aucune documentation prévue",
    description: "Le plan ne contient pas de tâche de documentation : la reprise par un autre intervenant sera difficile.",
    prob:2, impact:1, mesure:"Prévoir un guide d'usage et un guide d'exploitation"});
  if(tresElevees.length) R.push({
    titre: `${tresElevees.length} tâche${tresElevees.length > 1 ? "s" : ""} de complexité très élevée`,
    description: "Ces tâches nécessitent une attention particulière lors de la planification et du suivi.",
    prob:2, impact:2, mesure:"Examiner le découpage et les dépendances de ces tâches"});
  if(sansCrit.length) R.push({
    titre: `${sansCrit.length} story${sansCrit.length > 1 ? "s" : ""} sans critère d'acceptation`,
    description: "Sans critère d'acceptation, la recette se fait à l'appréciation : risque de désaccord en fin de sprint.",
    prob:1, impact:2, mesure:"Compléter les critères avant le démarrage"});
  if(hautes.length > taches.length * 0.5 && taches.length) R.push({
    titre: "Trop de tâches en priorité haute",
    description: `${hautes.length} tâches sur ${taches.length} sont prioritaires : la priorisation ne discrimine plus.`,
    prob:3, impact:2, mesure:"Ramener la priorité haute sous 50 % des tâches"});
  if(!R.length) R.push({
    titre: "Aucun risque structurel détecté",
    description: "Les contrôles automatiques ne relèvent pas de faiblesse majeure dans le plan.",
    prob:1, impact:1, mesure:"Valider le plan avec l'équipe"});
  return R;
}

function rendreRisques(){
  const R = construireRisques();
  const COUL = {1:"#94a3b8", 2:"#f59e0b", 3:"#e11d48"};
  const LIB = {1:"faible", 2:"moyen", 3:"élevé"};

  /* matrice */
  const cellules = {};
  R.forEach((r, i) => {
    const cle = r.prob + ":" + r.impact;
    (cellules[cle] = cellules[cle] || []).push(i + 1);
  });
  let grille = "";
  for(let impact = 3; impact >= 1; impact--){
    for(let prob = 1; prob <= 3; prob++){
      const g = prob * impact;
      const cls = g >= 6 ? "g3" : g >= 3 ? "g2" : "g1";
      const noms = cellules[prob + ":" + impact] || [];
      grille += `<div class="case ${cls}">${noms.map(n => `<span class="pastille">${n}</span>`).join("")}</div>`;
    }
  }
  $("#matrice").innerHTML = grille;
  $("#noteMatrice").textContent = `${R.length} risque${R.length > 1 ? "s" : ""} positionné${R.length > 1 ? "s" : ""}`;

  /* liste */
  $("#listeRisques").innerHTML = R.map((r, i) => {
    const g = r.prob * r.impact;
    const niv = g >= 6 ? "pr-haute" : g >= 3 ? "pr-moyenne" : "pr-basse";
    return `<div class="risque">
      <span class="num">${i + 1}</span>
      <span class="corps">
        <b>${esc(r.titre)}</b>
        <span>${esc(r.description)}</span>
        <span class="mes">Mesure : <b>${esc(r.mesure)}</b></span>
      </span>
      <span style="display:flex;gap:6px;flex-direction:column;align-items:flex-end">
        <span class="etq ${niv}">${LIB[r.prob * r.impact] || "moyen"}</span>
        <span class="vide" style="font-size:10px">P${r.prob} · I${r.impact}</span>
      </span>
    </div>`;
  }).join("");

  /* hypothèses */
  const a = META.analyse || {};
  const hyps = [];
  textes(a.contraintes).forEach(c => hyps.push(["Contrainte", c]));
  textes(a.utilisateurs).forEach(u => hyps.push(["Profil visé", u]));
  textes(a.concepts).forEach(c => hyps.push(["Concept", c]));
  $("#hypotheses").innerHTML = hyps.length
    ? hyps.map(([t, v]) => `<div class="li" style="display:flex;gap:10px;padding:8px 0;
        border-bottom:1px dotted var(--trait);font-size:12.2px;color:var(--encre-2)">
        <span class="chip" style="flex:0 0 auto;font-size:10px">${esc(t)}</span>
        <span>${esc(v)}</span></div>`).join("")
    : `<p class="vide">Aucune hypothèse extraite du brief.</p>`;
}


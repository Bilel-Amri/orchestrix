  $("#noteSansPreuve").textContent = `${sans.length} tâche${sans.length > 1 ? "s" : ""}`;
  $("#tableSansPreuve").innerHTML = sans.length ? `<table>
      <thead><tr><th style="width:82px">Clé</th><th>Tâche</th>

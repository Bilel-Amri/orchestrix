  margin-top:9px;font-family:var(--police);font-size:10.5px;color:var(--encre-4);
  font-variant-numeric:tabular-nums}
.attente .detail-attente b{color:var(--encre-2);font-weight:600}
@keyframes glisse{0%{left:-38%}100%{left:100%}}

.alerte{display:flex;gap:10px;padding:12px 14px;font-size:12.5px;line-height:1.55;
  margin-top:16px;border-left:1px solid var(--trait-2)}
.alerte svg{width:15px;height:15px;flex:0 0 15px;margin-top:2px}
.alerte.erreur{background:var(--bordeaux-clair);border-color:var(--bordeaux);color:#912018}
.alerte.avert{background:var(--moutarde-clair);border-color:var(--moutarde);color:#7a4508}
.alerte b{display:block;margin-bottom:2px}

/* ── en-tête de projet ────────────────────────────────────────────── */
.bandeau{background:var(--surface);border:1px solid var(--trait-2);border-radius:var(--r);
  margin-bottom:10px;overflow:hidden}
.bandeau-haut{padding:10px 14px 9px}
.bandeau h1{font-size:17px;letter-spacing:-.02em;margin:11px 0 9px;font-weight:500;
  max-width:920px;line-height:1.18}
.bandeau .obj{font-size:14px;color:var(--encre-3);max-width:820px;line-height:1.65}
.bandeau-bas{display:flex;flex-wrap:wrap;border-top:1px solid var(--trait)}
.bandeau-bas .m{padding:11px 22px;border-right:1px solid var(--trait);min-width:145px}
.bandeau-bas .m:last-child{border-right:0}
.bandeau-bas .m span{display:block;font-family:var(--police);
  font-size:10.5px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;
  color:var(--encre-4);margin-bottom:3px}
.bandeau-bas .m b{font-size:12.5px;font-weight:600;color:var(--encre-2)}

/* ── indicateurs : de simples chiffres séparés par des filets ──────── */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(132px,1fr));
  border:1px solid var(--trait);border-top:0;background:var(--surface);margin-bottom:24px}
.kpi{padding:15px 16px;border-right:1px solid var(--trait);position:relative}
.kpi:last-child{border-right:0}
.kpi .haut{display:flex;align-items:flex-start;justify-content:space-between;gap:6px}
.kpi .v{font-size:27px;font-weight:500;letter-spacing:-.02em;line-height:1.05;
  color:var(--encre)}
.kpi .v small{font-size:13px;color:var(--encre-4);margin-left:1px}
.kpi .l{font-family:var(--police);font-size:10.5px;font-weight:600;
  letter-spacing:.02em;text-transform:uppercase;color:var(--encre-3);margin-top:7px}
.kpi .s{font-family:var(--police);font-size:10px;
  color:var(--encre-4);margin-top:2px}
.kpi .puce{display:none}
.kpi .mini{height:2px;background:var(--trait);margin-top:9px}
.kpi .mini i{display:block;height:100%;background:var(--brique)}

/* ── grilles ──────────────────────────────────────────────────────── */
.g2{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:0;
  align-items:stretch;margin-bottom:24px;border:1px solid var(--trait)}
.g2b{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0;
  align-items:stretch;margin-bottom:24px;border:1px solid var(--trait)}
.g2 > .carte,.g2b > .carte{border:0;border-right:1px solid var(--trait)}
.g2 > .carte:last-child,.g2b > .carte:last-child{border-right:0}
@media (max-width:1120px){
  .g2,.g2b{grid-template-columns:1fr}
  .g2 > .carte,.g2b > .carte{border-right:0;border-bottom:1px solid var(--trait)}
}

.props{display:flex;flex-direction:column}
.prop{display:grid;grid-template-columns:112px minmax(0,1fr);gap:14px;padding:9px 0;
  border-bottom:1px solid var(--trait);align-items:start}
.prop:first-child{padding-top:0}
.prop:last-child{border-bottom:0;padding-bottom:0}
.prop dt{font-family:var(--police);font-size:10.5px;font-weight:600;
  letter-spacing:.02em;text-transform:uppercase;color:var(--encre-4);padding-top:3px}
.prop dd{margin:0;font-size:12.8px;color:var(--encre-2);line-height:1.6}

.bars{display:flex;flex-direction:column;gap:14px}
.bar-l{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:baseline}
.bar-l .n{font-size:12.5px;color:var(--encre-2);overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.bar-l .v{font-family:var(--police);font-size:10.5px;
  font-weight:600;color:var(--encre-3)}
.bar-t{grid-column:1/-1;height:3px;background:var(--surface-3);margin-top:-6px;overflow:hidden}
.bar-t i{display:block;height:100%;background:var(--encre-2)}

.anneau{position:relative;width:112px;height:112px;flex:0 0 112px}
.anneau svg{transform:rotate(-90deg)}
.anneau .cent{position:absolute;inset:0;display:grid;place-content:center;text-align:center}
.anneau .cent b{display:block;font-size:24px;font-weight:500;letter-spacing:-.02em;
  line-height:1}
.anneau .cent span{display:block;font-family:var(--police);
  font-size:10.5px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;
  color:var(--encre-4);margin-top:4px}
.legende{display:flex;flex-direction:column;gap:7px;font-size:12px;color:var(--encre-3);
  flex:1;min-width:0}
.legende .l{display:flex;align-items:center;gap:8px}
.legende .l i{width:7px;height:7px;flex:0 0 7px}
.legende .l b{margin-left:auto;color:var(--encre-2);font-weight:600;font-size:11.5px}

.pile{display:flex;height:7px;background:var(--surface-3);gap:1px}
.pile i{display:block;height:100%}

.controles{display:flex;flex-direction:column}
.controle{display:flex;align-items:flex-start;gap:10px;padding:11px 0;
  border-bottom:1px solid var(--trait)}
.controle:last-child{border-bottom:0;padding-bottom:0}
.controle:first-child{padding-top:0}
.controle .pico{width:16px;height:16px;flex:0 0 16px;margin-top:2px;display:grid;
  place-items:center;border:1px solid currentColor}
.controle .pico svg{width:9px;height:9px}
.controle .pico.ok{color:var(--olive)}
.controle .pico.ko{color:var(--moutarde)}
.controle .txt{flex:1;min-width:0}
.controle .txt b{font-size:12.5px;font-weight:600;color:var(--encre-2);display:block}
.controle .txt span{font-family:var(--police);font-size:10.5px;
  color:var(--encre-4)}
.controle .res{font-family:var(--police);font-size:10.5px;
  font-weight:600;letter-spacing:.02em;text-transform:uppercase;color:var(--encre-4);
  white-space:nowrap}

/* ── backlog ──────────────────────────────────────────────────────── */
.barre-outils{display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  padding-bottom:12px;margin-bottom:0;border-bottom:1px solid var(--trait-2)}
.barre-outils .titre{font-size:20px;font-weight:500;letter-spacing:-.015em;margin-right:auto}
.barre-outils .titre span{font-family:var(--police);font-size:10.5px;
  font-weight:600;letter-spacing:.02em;text-transform:uppercase;color:var(--encre-4);
  margin-left:10px}
.seg{display:inline-flex;border:1px solid var(--trait-2);border-radius:var(--r-s);
  overflow:hidden;background:var(--surface)}
.seg button{padding:6px 12px;font-family:var(--police);
  font-size:12px;font-weight:500;letter-spacing:0;
  color:var(--encre-3);border-right:1px solid var(--trait)}
.seg button:last-child{border-right:0}
.seg button:hover{background:var(--surface);color:var(--encre)}
.seg button.on{background:var(--encre);color:var(--fond)}

.epic{background:var(--surface);border:1px solid var(--trait-2);
  border-radius:var(--r);margin-top:10px}
.epic:hover{border-left-color:var(--brique)}
.epic-tete{display:flex;align-items:center;gap:14px;padding:13px 16px;cursor:pointer;
  user-select:none;transition:background .12s}
.epic-tete:hover{background:var(--surface-3)}
.epic-num{font-family:var(--mono);font-size:11px;font-weight:600;
  color:var(--encre-4);flex:0 0 22px}
.epic-nom{flex:1;min-width:0}
.epic-nom b{display:block;font-size:15px;font-weight:600;letter-spacing:-.01em}
.epic-nom span{display:block;font-family:var(--police);font-size:11px;
  color:var(--encre-4);margin-top:2px;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.epic-meta{display:flex;gap:10px;align-items:center;flex:0 0 auto;
  font-family:var(--police);font-size:10.5px;letter-spacing:.02em;
  text-transform:uppercase;color:var(--encre-4)}
.epic-meta .t.p{color:var(--brique);font-weight:700}
.chev{width:12px;height:12px;color:var(--encre-4);flex:0 0 12px;transition:transform .16s}
.epic.ouvert .chev{transform:rotate(90deg);color:var(--brique)}
.epic-corps{display:none;border-top:1px solid var(--trait)}
.epic.ouvert .epic-corps{display:block}
.epic-desc{padding:11px 16px;font-size:12.5px;color:var(--encre-3);
  border-bottom:1px solid var(--trait);line-height:1.6}

.story{padding:15px 16px;border-bottom:1px solid var(--trait)}
.story:last-child{border-bottom:0}
.story-tete{display:flex;align-items:baseline;gap:10px;margin-bottom:6px;flex-wrap:wrap}
.story-titre{font-size:14px;font-weight:600;flex:1;min-width:200px}
.story-pts{font-family:var(--police);font-size:10px;
  font-weight:700;letter-spacing:.08em;color:var(--encre-4)}
.recit{font-size:12.5px;color:var(--encre-3);margin:0 0 10px;line-height:1.6;
  font-style:italic}
.recit b{color:var(--encre-2);font-weight:600;font-style:normal}
.criteres{border-left:2px solid var(--trait-2);padding:2px 0 2px 12px;margin-bottom:12px}
.criteres .cl{font-family:var(--police);font-size:10.5px;
  font-weight:600;letter-spacing:.02em;text-transform:uppercase;color:var(--encre-4);
  margin-bottom:5px}
.criteres div.c{font-size:12px;color:var(--encre-2);padding:1px 0;display:flex;gap:7px}
.criteres div.c svg{width:11px;height:11px;flex:0 0 11px;color:var(--olive);margin-top:4px}
.table-enveloppe{border:1px solid var(--trait)}

/* ── tableau par nature ───────────────────────────────────────────── */
.kanban{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;
  margin-top:12px}
@media (max-width:1240px){.kanban{grid-template-columns:repeat(2,minmax(0,1fr))}}
.col{padding:9px;border:1px solid var(--trait-2);border-radius:var(--r);
  background:var(--surface-3);min-height:120px}
.col:last-child{border-color:var(--trait)}
.col-tete{display:flex;align-items:center;gap:7px;padding:0 2px 9px;
  border-bottom:1px solid var(--trait-2);margin-bottom:9px}
.col-tete b{font-family:var(--police);font-size:10.5px;font-weight:600;
  letter-spacing:.02em;text-transform:uppercase;color:var(--encre-2)}
.col-tete span{margin-left:auto;font-family:var(--police);
  font-size:9.5px;font-weight:700;color:var(--encre-4)}
.carte-k{background:var(--surface);border:1px solid var(--trait-2);padding:9px 10px;
  margin-bottom:6px;border-radius:var(--r-s);
  transition:border-color .12s}
.carte-k:last-child{margin-bottom:0}
.carte-k:hover{border-color:var(--brique)}
.carte-k .kt{font-size:12px;font-weight:600;line-height:1.45;margin-bottom:6px}
.carte-k .kl{display:flex;align-items:center;gap:6px;flex-wrap:wrap;
  font-family:var(--police);font-size:9.5px;color:var(--encre-4)}
.carte-k .kl .pt{font-weight:700;color:var(--encre-3)}
.carte-k .ke{font-family:var(--police);font-size:9.5px;
  color:var(--encre-5);margin-top:6px;padding-top:5px;border-top:1px solid var(--trait);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.col-vide{font-family:var(--police);font-size:10px;
  color:var(--encre-5);text-align:center;padding:12px 0;font-style:italic}

/* ── sources ──────────────────────────────────────────────────────── */
.flux{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));
  border:1px solid var(--trait)}
.flux .etape{padding:13px 14px;border-right:1px solid var(--trait)}
.flux .etape:last-child{border-right:0}
.flux .etape span{display:block;font-family:var(--police);
  font-size:10.5px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;
  color:var(--encre-4);margin-bottom:5px}
.flux .etape b{font-size:22px;font-weight:500;letter-spacing:-.02em}
.flux .etape .d{font-family:var(--police);font-size:10px;
  color:var(--encre-5);margin-top:1px}
.barre{height:4px;background:var(--surface-3);overflow:hidden}
.barre i{display:block;height:100%;background:var(--encre-3)}
.bloc{margin-bottom:24px}

/* ── planification ────────────────────────────────────────────────── */
.params{display:flex;gap:20px;flex-wrap:wrap;align-items:flex-end}
.champ{display:flex;flex-direction:column;gap:5px}
.champ label{font-family:var(--police);font-size:10.5px;
  font-weight:600;letter-spacing:.02em;text-transform:uppercase;color:var(--encre-4)}
.champ select,.champ input{height:31px;min-width:110px;border:1px solid var(--trait-2);
  background:var(--surface);padding:0 8px;font-family:var(--police);
  font-size:11.5px;color:var(--encre);outline:none;cursor:pointer}
.champ select:focus,.champ input:focus{border-color:var(--brique)}

.gantt{display:flex;flex-direction:column;gap:9px}
.gantt-l{display:grid;grid-template-columns:200px minmax(0,1fr);gap:12px;align-items:center}
.gantt-l .n{font-size:12px;color:var(--encre-2);overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}
.gantt-l .n em{display:block;font-style:normal;font-family:var(--police);
  font-size:9.5px;color:var(--encre-4)}
.gantt-piste{position:relative;height:22px;background:var(--surface-3)}
.gantt-bloc{position:absolute;top:0;height:100%;display:flex;align-items:center;
  padding:0 7px;color:#ffffff;font-family:var(--police);
  font-size:9.5px;font-weight:700;letter-spacing:.06em;white-space:nowrap;overflow:hidden}
.axe{display:flex;justify-content:space-between;margin:10px 0 0 212px;
  border-top:1px solid var(--trait);padding-top:6px;
  font-family:var(--police);font-size:9px;color:var(--encre-4)}

.sprints{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0;
  border:1px solid var(--trait)}
.sprint{padding:13px 14px;border-right:1px solid var(--trait)}
.sprint:last-child{border-right:0}
.sprint .sh{display:flex;align-items:baseline;justify-content:space-between;gap:8px;
  margin-bottom:8px;padding-bottom:7px;border-bottom:1px solid var(--trait)}
.sprint .sh b{font-size:13px;font-weight:600}
.sprint .sh span{font-family:var(--police);font-size:9.5px;
  font-weight:700;letter-spacing:.08em;color:var(--brique)}
.sprint .li{display:flex;gap:7px;font-size:11.5px;color:var(--encre-3);padding:5px 0;
  border-bottom:1px dotted var(--trait)}
.sprint .li code{font-family:var(--mono);font-size:9px;
  color:var(--encre-4);flex:0 0 auto}
.sprint .li span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sprint .plus{font-family:var(--police);font-size:10px;
  color:var(--encre-4);padding-top:7px}
.sprint .barre-s{height:2px;background:var(--surface-3);margin-top:10px}
.sprint .barre-s i{display:block;height:100%;background:var(--brique)}
.courbe{width:100%;height:158px;display:block}

/* ── risques ──────────────────────────────────────────────────────── */
.matrice-bloc{display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap}
.matrice{display:grid;grid-template-columns:repeat(3,56px);grid-template-rows:repeat(3,42px);
  gap:1px;background:var(--trait)}
.case{background:var(--surface);display:grid;place-items:center;gap:2px;
  font-family:var(--police);font-size:10px;color:var(--trait-2)}
.case.g1{background:#eef0e4;color:var(--olive)}
.case.g2{background:#f7f0d9;color:var(--moutarde)}
.case.g3{background:#f4dfe2;color:var(--bordeaux)}
.pastille{width:20px;height:20px;background:var(--surface);border:1px solid currentColor;
  display:grid;place-items:center;font-size:9.5px;font-weight:700}
.axes-matrice{display:flex;flex-direction:column;justify-content:space-between;height:128px;
  font-family:var(--police);font-size:9px;color:var(--encre-4);
  text-align:right}
.axes-matrice b{font-weight:600;letter-spacing:.02em;text-transform:uppercase;
  color:var(--encre-3);font-size:10.5px}
.risque{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:12px;
  padding:12px 0;border-bottom:1px solid var(--trait);align-items:start}
.risque:last-child{border-bottom:0;padding-bottom:0}
.risque:first-child{padding-top:0}
.risque .num{font-family:var(--mono);font-size:11px;font-weight:600;
  color:var(--encre-4);margin-top:1px}
.risque .corps b{display:block;font-size:13px;font-weight:600;color:var(--encre);
  margin-bottom:2px}
.risque .corps span{font-size:12px;color:var(--encre-3);line-height:1.55;display:block}
.risque .corps .mes{display:block;margin-top:5px;font-size:11.5px;color:var(--olive)}
.risque .corps .mes b{display:inline;font-size:11.5px;font-weight:700;color:var(--olive)}

/* ── panneau de détail ────────────────────────────────────────────── */
.voile{position:fixed;inset:0;background:rgba(28,26,23,.42);z-index:190}
.panneau{position:fixed;top:0;right:0;height:100vh;width:470px;max-width:94vw;z-index:200;
  background:var(--surface);border-left:1px solid var(--trait-2);display:flex;
  flex-direction:column;box-shadow:-4px 0 16px rgba(13,18,25,.10)}
.panneau-tete{display:flex;align-items:flex-start;gap:12px;padding:16px 18px;
  border-bottom:1px solid var(--trait);background:var(--surface)}
.panneau-tete .t{flex:1;min-width:0}
.panneau-tete .t b{display:block;font-size:15px;font-weight:600;line-height:1.35;
  margin-top:7px}
.panneau-tete .fermer{width:26px;height:26px;display:grid;place-items:center;
  color:var(--encre-4);flex:0 0 26px;border:1px solid transparent}
.panneau-tete .fermer:hover{border-color:var(--trait-2);color:var(--encre)}
.panneau-tete .fermer svg{width:13px;height:13px}
.panneau-corps{flex:1;overflow-y:auto;padding:18px}
.panneau-section{margin-bottom:22px}
.panneau-section:last-child{margin-bottom:0}
.panneau-section h4{font-family:var(--police);font-size:10.5px;
  font-weight:600;letter-spacing:.02em;text-transform:uppercase;color:var(--encre-4);
  margin-bottom:8px;padding-bottom:5px;border-bottom:1px solid var(--trait)}
.panneau .desc{font-size:12.8px;color:var(--encre-2);line-height:1.65}
.panneau .metas{display:grid;grid-template-columns:1fr 1fr;gap:0;
  border:1px solid var(--trait)}
.panneau .metas div{padding:8px 10px;border-right:1px solid var(--trait);
  border-bottom:1px solid var(--trait)}
.panneau .metas div:nth-child(2n){border-right:0}
.panneau .metas span{display:block;font-family:var(--police);
  font-size:10.5px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;
  color:var(--encre-4);margin-bottom:2px}
.panneau .metas b{font-size:12.5px;font-weight:600;color:var(--encre)}
.panneau .epic-lien{font-size:12.5px;color:var(--encre-2);border-left:2px solid var(--brique);
  padding:2px 0 2px 11px}
.panneau .preuve-l{display:flex;gap:9px;font-size:12px;color:var(--encre-2);
  padding:8px 0;border-bottom:1px dotted var(--trait)}
.panneau .preuve-l:last-child{border-bottom:0}
.panneau .preuve-l b{flex:0 0 auto;font-family:var(--mono);
  font-size:10px;color:var(--brique)}
.panneau .preuve-l a{font-size:10.5px}
.panneau-pied{padding:12px 18px;border-top:1px solid var(--trait-2);display:flex;gap:8px;
  background:var(--surface-3)}

/* ── palette de commandes ─────────────────────────────────────────── */
.palette{position:fixed;inset:0;z-index:300;display:flex;align-items:flex-start;
  justify-content:center;padding-top:12vh;background:rgba(28,26,23,.45)}
.palette-boite{width:560px;max-width:92vw;background:var(--surface);
  border:1px solid var(--trait-2);border-radius:var(--r);box-shadow:var(--ombre-p);
  overflow:hidden}
.palette-boite input{width:100%;height:48px;border:0;border-bottom:1px solid var(--trait-2);
  padding:0 16px;font:inherit;font-size:15px;outline:none;background:transparent;
  color:var(--encre)}
.palette-liste{max-height:330px;overflow-y:auto}
.palette-item{display:flex;align-items:center;gap:11px;padding:9px 15px;font-size:13px;
  color:var(--encre-2);cursor:pointer;border-bottom:1px solid var(--trait)}
.palette-item svg{width:13px;height:13px;flex:0 0 13px;color:var(--encre-4)}
.palette-item.on{background:var(--surface-3);box-shadow:inset 2px 0 0 var(--brique)}
.palette-item.on svg{color:var(--brique)}
.palette-item .g{margin-left:auto;font-family:var(--police);
  font-size:10.5px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;
  color:var(--encre-4)}
.palette-vide{padding:20px;text-align:center;font-family:var(--police);
  font-size:11.5px;color:var(--encre-4)}
.palette-pied{border-top:1px solid var(--trait-2);padding:8px 14px;display:flex;gap:16px;
  font-family:var(--police);font-size:9.5px;color:var(--encre-4);
  background:var(--surface-3)}
.palette-pied kbd{font-family:var(--mono);font-size:9px;
  border:1px solid var(--trait-2);padding:1px 4px;margin-right:4px}

/* ── validation humaine ───────────────────────────────────────────── */
.bandeau-validation{display:flex;align-items:center;gap:14px;padding:13px 18px;
  border:1px solid var(--trait);
  background:var(--surface);margin-bottom:0;flex-wrap:wrap}
.bandeau-validation .pastille-v{width:28px;height:28px;display:grid;place-items:center;
  flex:0 0 28px;border:1px solid currentColor}
.bandeau-validation .pastille-v svg{width:13px;height:13px}
.bandeau-validation.atteinte{border-left-color:var(--moutarde)}
.bandeau-validation.atteinte .pastille-v{color:var(--moutarde);
  background:var(--moutarde-clair)}
.bandeau-validation.ok{border-left-color:var(--olive)}
.bandeau-validation.ok .pastille-v{color:var(--olive);background:var(--olive-clair)}
.bandeau-validation.ko{border-left-color:var(--bordeaux)}
.bandeau-validation.ko .pastille-v{color:var(--bordeaux);
  background:var(--bordeaux-clair)}
.bandeau-validation .txt-v{flex:1;min-width:200px}
.bandeau-validation .txt-v b{display:block;font-size:13.5px;font-weight:600}
.bandeau-validation .txt-v span{font-family:var(--police);
  font-size:11px;color:var(--encre-3);line-height:1.5}
.bandeau-validation .actions-v{display:flex;gap:7px;flex-wrap:wrap}
.zone-motif{width:100%;margin-top:6px;padding-top:10px;border-top:1px solid var(--trait)}
.zone-motif textarea{width:100%;min-height:62px;border:1px solid var(--trait-2);
  padding:9px 11px;font:inherit;font-size:12.5px;resize:vertical;outline:none;
  background:var(--fond);color:var(--encre)}
.zone-motif textarea:focus{border-color:var(--brique)}

/* ── espace de travail ────────────────────────────────────────────── */
.entete-espace{display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;
  padding-bottom:16px;border-bottom:1px solid var(--trait-2);margin-bottom:0}
.entete-espace .txt{flex:1;min-width:240px}
.entete-espace h1{font-size:26px;letter-spacing:-.02em;margin-bottom:5px;font-weight:500}
.entete-espace .obj{font-size:13.5px;color:var(--encre-3);max-width:740px;line-height:1.6}
.entete-espace .meta{font-family:var(--police);font-size:10.5px;
  letter-spacing:.02em;text-transform:uppercase;color:var(--encre-4);margin-top:7px}
.entete-espace .actions{display:flex;gap:8px;flex-wrap:wrap}
.vide-bloc{border:1px dashed var(--trait-2);
  padding:44px 24px;text-align:center;background:var(--surface)}
.vide-bloc h3{font-size:19px;margin-bottom:7px;font-weight:500}
.vide-bloc p{font-size:13px;color:var(--encre-3);max-width:420px;margin:0 auto 18px;
  line-height:1.65}

.membre{display:flex;align-items:center;gap:11px;padding:10px 0;
  border-bottom:1px solid var(--trait)}
.membre:last-child{border-bottom:0}
.membre:first-child{padding-top:0}
.avatar{width:28px;height:28px;flex:0 0 28px;display:grid;place-items:center;
  border:1px solid var(--encre-3);font-family:var(--police);
  font-size:9.5px;font-weight:700;letter-spacing:.06em;color:var(--encre-2);
  background:var(--surface-3)}
.avatar.petit{width:18px;height:18px;flex:0 0 18px;font-size:8px}
.membre .infos{flex:1;min-width:0}
.membre .infos b{display:block;font-size:12.5px;font-weight:600}
.membre .infos span{display:block;font-family:var(--police);
  font-size:10px;color:var(--encre-4)}
.membre .chg{text-align:right;flex:0 0 104px}
.membre .taux{font-family:var(--police);font-size:10px;
  font-weight:700;color:var(--encre-3)}
.membre .taux.trop{color:var(--bordeaux)}
.membre .jauge{display:block;height:2px;background:var(--surface-3);margin-top:4px}
.membre .jauge i{display:block;height:100%;background:var(--encre-3)}
.membre .jauge i.trop{background:var(--bordeaux)}

.ligne-equipe{display:grid;grid-template-columns:1fr 158px 30px;gap:8px;
  margin-bottom:8px;align-items:center}
.ligne-equipe input,.ligne-equipe select{height:31px;border:1px solid var(--trait-2);
  padding:0 8px;font-family:var(--police);font-size:11.5px;
  background:var(--surface);color:var(--encre);outline:none;min-width:0}
.ligne-equipe input:focus,.ligne-equipe select:focus{border-color:var(--brique)}

.resume-exec{display:grid;grid-template-columns:repeat(auto-fit,minmax(92px,1fr));
  border:1px solid var(--trait);background:var(--surface)}
.resume-item{padding:11px 13px;border-right:1px solid var(--trait)}
.resume-item:last-child{border-right:0}
.resume-item b{display:block;font-size:20px;font-weight:500;letter-spacing:-.02em}
.resume-item span{display:block;font-family:var(--police);
  font-size:10.5px;font-weight:600;letter-spacing:.02em;text-transform:uppercase;
  color:var(--encre-4);margin-top:2px}

.puce-membre{display:inline-flex;align-items:center;gap:7px;padding:4px 10px;
  border:1px solid var(--trait-2);background:transparent;
  font-family:var(--police);font-size:10.5px;font-weight:600;
  color:var(--encre-3);transition:.12s}
.puce-membre:hover{border-color:var(--encre-3);color:var(--encre)}
.puce-membre.on{background:var(--encre);border-color:var(--encre);color:var(--fond)}

.sel-statut{height:26px;font-family:var(--police);font-size:10.5px;
  font-weight:600;letter-spacing:.02em;text-transform:uppercase;padding:0 6px;
  border:1px solid var(--trait-2);background:var(--surface);color:var(--encre-2);
  cursor:pointer;outline:none;width:100%}
.sel-statut.s-termine{color:var(--olive);border-color:var(--olive);background:var(--olive-clair)}
.sel-statut.s-en_cours{color:var(--brique);border-color:var(--brique);
  background:var(--brique-clair)}
.sel-statut.s-en_revue{color:var(--encre-2);border-color:var(--encre-3);
  background:var(--surface-3)}
.sel-statut.s-bloque{color:var(--bordeaux);border-color:var(--bordeaux);
  background:var(--bordeaux-clair)}
.qui{display:inline-flex;align-items:center;gap:7px;font-size:12px}
.sel-large{width:100%;height:32px;border:1px solid var(--trait-2);padding:0 9px;
  font-family:var(--police);font-size:12px;background:var(--surface);
  color:var(--encre)}
.histo{display:flex;gap:10px;padding:5px 0;border-bottom:1px dotted var(--trait);
  font-size:11.5px;color:var(--encre-3)}
.histo:last-child{border-bottom:0}
.histo span{font-family:var(--police);font-size:9.5px;
  color:var(--encre-5);flex:0 0 88px}
.histo b{font-weight:500;color:var(--encre-2)}
.comm{border-left:2px solid var(--trait-2);padding:2px 0 2px 11px;margin-bottom:10px}
.comm b{font-size:12px;font-weight:700}
.comm span{font-family:var(--police);font-size:9.5px;
  color:var(--encre-4);margin-left:7px}
.comm p{margin:4px 0 0;font-size:12.5px;color:var(--encre-2);line-height:1.55}
.zone-comm{width:100%;border:1px solid var(--trait-2);padding:8px 10px;font:inherit;
  font-size:12.5px;resize:vertical;outline:none;background:var(--fond);
  color:var(--encre)}
.zone-comm:focus{border-color:var(--brique)}

/* ── Jira ─────────────────────────────────────────────────────────── */
.bloc-jira{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0;
  align-items:stretch;margin-bottom:24px;border:1px solid var(--trait)}
.bloc-jira > *{border-right:1px solid var(--trait)}
.bloc-jira > *:last-child{border-right:0}
.bloc-jira .carte{border:0;border-bottom:1px solid var(--trait)}
.bloc-jira .carte:last-child{border-bottom:0}
@media (max-width:1000px){
  .bloc-jira{grid-template-columns:1fr}
  .bloc-jira > *{border-right:0;border-bottom:1px solid var(--trait)}
}
.champ-jira{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}
.champ-jira label{font-family:var(--police);font-size:10.5px;
  font-weight:600;letter-spacing:.02em;text-transform:uppercase;color:var(--encre-4)}
.champ-jira input{height:32px;border:1px solid var(--trait-2);padding:0 10px;
  font-family:var(--police);font-size:12px;background:var(--surface);
  color:var(--encre);outline:none}
.champ-jira input:focus{border-color:var(--brique)}
.champ-jira .aide{font-family:var(--police);font-size:10px;
  color:var(--encre-4);font-style:italic}
.etat-jira{display:inline-flex;align-items:center;gap:6px;
  font-family:var(--police);font-size:10.5px;font-weight:600;
  letter-spacing:.02em;text-transform:uppercase;padding:4px 9px;border:1px solid}
.etat-jira i{width:4px;height:4px;display:inline-block}
.etat-jira.ok{color:var(--olive);border-color:var(--olive);background:var(--olive-clair)}
.etat-jira.ok i{background:var(--olive)}
.etat-jira.non{color:var(--encre-4);border-color:var(--trait-2);background:transparent}
.etat-jira.non i{background:var(--encre-4)}
.ok-txt{font-family:var(--police);font-size:11px;
  color:var(--olive);font-weight:600}
.ko-txt{font-family:var(--police);font-size:11px;
  color:var(--bordeaux);font-weight:600}
.actions-jira{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}
pre.code{background:var(--surface-3);border:1px solid var(--trait);padding:11px 13px;
  font-family:var(--mono);font-size:11px;line-height:1.7;
  color:var(--encre-2);overflow-x:auto;margin:8px 0 0;white-space:pre-wrap}
.modele-detecte{margin-top:14px}
.modele-detecte .l{display:flex;align-items:center;gap:8px;font-size:12px;
  color:var(--encre-2);padding:6px 0;border-top:1px solid var(--trait)}
.modele-detecte .l b{margin-left:auto;font-family:var(--police);
  font-size:10.5px;font-weight:600;color:var(--encre-3)}

/* ── liens croisés ────────────────────────────────────────────────── */
.lien-page{display:inline-flex;align-items:center;gap:5px;
  font-family:var(--police);font-size:10.5px;font-weight:600;
  letter-spacing:.02em;text-transform:uppercase;color:var(--brique);
  border-bottom:1px solid var(--brique);padding-bottom:1px;cursor:pointer;
  text-decoration:none;transition:.12s}
.lien-page:hover{color:var(--brique-fonce);border-color:var(--brique-fonce);
  text-decoration:none}
.lien-page::after{content:"›";font-size:12px;line-height:1}

/* ── mode présentation ────────────────────────────────────────────── */
body.presentation .rail{display:none}
body.presentation .contenu{max-width:1620px;padding:36px 44px 64px}
body.presentation .kpi .v{font-size:33px}
body.presentation .bandeau h1{font-size:34px}
body.presentation .epic-tete{padding:16px 19px}
.bouton-presentation{position:fixed;right:18px;bottom:18px;z-index:120}

/* ── tuiles de raccourcis ────────────────────────────────────────── */
.tuiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:10px;
  margin:0 0 12px}
.tuile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;
  min-height:72px;padding:9px 8px;border:1px solid rgba(0,0,0,.12);border-radius:var(--r);
  color:#fff;cursor:pointer;text-align:center;transition:filter .12s}
.tuile:hover{filter:brightness(1.08)}
.tuile:active{transform:translateY(1px)}
.tuile svg{width:18px;height:18px;opacity:.95}
.tuile b{font-size:11.5px;font-weight:600;line-height:1.25}
.tuile em{font-style:normal;font-size:10px;opacity:.85}
.t-ocre{background:var(--t-ocre)} .t-vert{background:var(--t-vert)}
.t-brique{background:var(--t-brique)} .t-ardoise{background:var(--t-ardoise)}
.entete-page{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;
  padding:2px 2px 8px;flex-wrap:wrap}
.entete-page h1{font-size:16px;font-weight:700;letter-spacing:0;margin:0}
.entete-page .sous{font-size:11.5px;color:var(--encre-3);margin-top:1px}
.entete-page .droite{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px;align-items:start}
.g2b{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:12px;align-items:start}
@media(max-width:1080px){.g2b{grid-template-columns:1fr}}

/* ── impression ───────────────────────────────────────────────────── */
@media print{
  .rail,.topbar,.pied-page,.recherche{display:none !important}
  body{background:#ffffff}
  .principal{background:#ffffff}
  .contenu{max-width:none;padding:0}
  .epic-corps{display:block !important}
  .carte,.epic,.bandeau{break-inside:avoid}
}
@media (max-width:900px){
  .rail{display:none}
  .contenu{padding:18px}
  .recherche input{width:140px}
  .hero h1{font-size:27px}
  .kanban{grid-template-columns:1fr}
}

/* ── lignes cliquables ─────────────────────────────────────────────── */
.ligne-clic{cursor:pointer}
tr.ligne-clic:hover td{background:var(--surface-3)}
.ligne-clic:hover .t-titre{color:var(--brique)}

/* ── marque ───────────────────────────────────────────────────────── */
.marque{display:none}
.marque .sigle{width:26px;height:26px;flex:0 0 26px;border-radius:var(--r-s);
  display:grid;place-items:center;color:#fff;background:var(--brique)}
.marque .sigle svg{width:16px;height:16px}
.marque .nom{line-height:1.15}
</style>
</head>
<body>
<div class="app">

  <!-- ══════════════ PRINCIPAL ══════════════ -->
  <div class="bandeau-app">
  <!-- ══════════════ RAIL ══════════════ -->
  <aside class="rail">
    <div class="marque">
      <span class="sigle" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 7h6a4 4 0 0 1 4 4v6"/><path d="M20 7h-4a4 4 0 0 0-4 4v6"/>
          <circle cx="4" cy="7" r="1.6" fill="currentColor" stroke="none"/>
          <circle cx="20" cy="7" r="1.6" fill="currentColor" stroke="none"/>
        </svg>
      </span>
      <span class="nom">Orchestrix<span class="ver">Pilotage de projet</span></span>
    </div>

    <div class="rail-projet off" id="railProjet">
      <div class="etq"><i></i>Sujet du projet</div>
      <strong id="railSujet">Aucun projet chargé</strong>
      <div class="sub" id="railSub">Décrivez un brief pour démarrer</div>
      <div class="jauge"><i id="railJauge" style="width:0%"></i></div>
    </div>

    <div class="rail-groupe">
      <div class="lib">Projets</div>
      <nav class="rail-nav">
        <button data-vue="saisie" class="actif">
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M10 4.5v11M4.5 10h11" stroke-linecap="round"/></svg>
          Nouveau brief
        </button>
        <button data-vue="plan" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="3" y="3" width="6" height="6" rx="1.6"/><rect x="11" y="3" width="6" height="4" rx="1.6"/>
            <rect x="11" y="9" width="6" height="8" rx="1.6"/><rect x="3" y="11" width="6" height="6" rx="1.6"/></svg>
          Synthèse
        </button>
        <button data-vue="backlog" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M7 5.5h9.5M7 10h9.5M7 14.5h6" stroke-linecap="round"/>
            <circle cx="3.6" cy="5.5" r="1" fill="currentColor"/>
            <circle cx="3.6" cy="10" r="1" fill="currentColor"/>
            <circle cx="3.6" cy="14.5" r="1" fill="currentColor"/></svg>
          Backlog <span class="badge" id="bBacklog"></span>
        </button>
        <button data-vue="tableau" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="2.8" y="3" width="4.2" height="14" rx="1.3"/>
            <rect x="8.2" y="3" width="4.2" height="9" rx="1.3"/>
            <rect x="13.6" y="3" width="3.6" height="11.5" rx="1.3"/></svg>
          Tableau <span class="badge" id="bTableau"></span>
        </button>
      </nav>
    </div>

    <div class="rail-groupe">
      <div class="lib">Équipe</div>
      <nav class="rail-nav">
        <button data-vue="espace" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="7.4" cy="7.2" r="2.6"/><path d="M2.6 16c0-2.7 2.1-4.4 4.8-4.4s4.8 1.7 4.8 4.4"
              stroke-linecap="round"/><circle cx="14.4" cy="8.4" r="1.9" opacity=".55"/>
            <path d="M13.4 12.4c2.2.2 3.8 1.6 3.8 3.6" stroke-linecap="round" opacity=".55"/></svg>
          Espace de travail <span class="badge" id="bEquipe"></span>
        </button>
        <button data-vue="execution" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M3.5 10.4l3.6 3.6 9.4-9.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Exécution <span class="badge" id="bExec"></span>
        </button>
        <button data-vue="jira" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M10 2.8 4.6 8.2a2 2 0 0 0 0 2.8l2.6 2.6 2.8-2.8-1.4-1.4 2.6-2.6"
              stroke-linejoin="round"/>
            <path d="M10 17.2l5.4-5.4a2 2 0 0 0 0-2.8L12.8 6.4 10 9.2l1.4 1.4-2.6 2.6"
              stroke-linejoin="round" opacity=".55"/></svg>
          Jira
        </button>
      </nav>
    </div>

    <div class="rail-groupe">
      <div class="lib">Assurance qualité</div>
      <nav class="rail-nav">
        <button data-vue="qualite" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M10 2.8 16 5v5.2c0 3.3-2.5 5.9-6 7-3.5-1.1-6-3.7-6-7V5l6-2.2Z"
                  stroke-linejoin="round"/><path d="M7.4 9.9l1.9 1.9 3.4-3.6"
                  stroke-linecap="round" stroke-linejoin="round"/></svg>
          Contrôles
        </button>
        <button data-vue="planification" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="3" y="4.5" width="14" height="12" rx="2"/>
            <path d="M3 8.4h14M6.6 2.8v3.2M13.4 2.8v3.2" stroke-linecap="round"/>
            <path d="M6.2 11.4h4.6" stroke-linecap="round"/></svg>
          Planification
        </button>
        <button data-vue="risques" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M10 3.2 18 17H2z" stroke-linejoin="round"/>
            <path d="M10 8.2v3.6M10 14.4v.1" stroke-linecap="round"/></svg>
          Risques <span class="badge" id="bRisques"></span>
        </button>
        <button data-vue="sources" data-plan="1" disabled>
          <svg class="ico" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M4 3.5h8.5L16 7v9.5H4z" stroke-linejoin="round"/>
            <path d="M12 3.6V7h3.6" stroke-linejoin="round"/></svg>
          Sources &amp; preuves <span class="badge" id="bSources"></span>

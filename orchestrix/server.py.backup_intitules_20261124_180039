function dessinerEquipe(){
  const roles = (PROJET.roles || []);
  $("#lignesEquipe").innerHTML = window._equipe.map((m, i) => `
    <div class="ligne-equipe">
      <input placeholder="Nom du membre" value="${esc(m.nom || "")}"

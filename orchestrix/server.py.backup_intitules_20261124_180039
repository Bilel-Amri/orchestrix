  const anc = Math.round((q.taux_ancrage || 0) * 100);
  const couv = Math.round((q.couverture || 0) * 100);

  $("#anneauAncrage").innerHTML = anneauHTML(anc, "Sourcées");
  $("#noteAncrage").textContent = `${nf(taches.length - sans.length)} sur ${nf(taches.length)}`;
  $("#propsAncrage").innerHTML = `
    <div class="prop"><dt>Tâches</dt><dd>${nf(taches.length)}</dd></div>
    <div class="prop"><dt>Avec preuve</dt><dd>${nf(taches.length - sans.length)}</dd></div>

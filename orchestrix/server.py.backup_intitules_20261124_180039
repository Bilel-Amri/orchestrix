  hote.id = "palette";
  hote.className = "palette";
  hote.innerHTML = `
    <div class="palette-boite">
      <input id="paletteInput" type="text" placeholder="Taper une commande ou un nom de tâche…" autocomplete="off">
      <div class="palette-liste" id="paletteListe"></div>
      <div class="palette-pied">
        <span><kbd>↑</kbd><kbd>↓</kbd> parcourir</span>
        <span><kbd>Entrée</kbd> ouvrir</span>
        <span><kbd>Échap</kbd> fermer</span>
        <span style="margin-left:auto">⌘K</span>
      </div>
    </div>`;
  document.body.appendChild(hote);
  hote.onclick = e => { if(e.target === hote) fermerPalette(); };
  const inp = $("#paletteInput");
  inp.addEventListener("input", () => filtrerPalette(inp.value));
  inp.addEventListener("keydown", naviguerPalette);
  filtrerPalette("");
  inp.focus();
}

function fermerPalette(){
  const p = $("#palette"); if(p) p.remove();
  PALETTE_ACTIF = 0;
}

function filtrerPalette(q){
  const base = commandes().map(c => ({type:"cmd", titre:c.t, groupe:c.g, ico:c.i, action:c.f}));
  if(PLAN && q.trim()){
    toutesLesTaches().forEach(({t, epic}, k) => {
      if(k > 400) return;
      base.push({type:"tache", titre:t.title, groupe:"Tâche · " + t.cle, ico:"task",
        action:() => ouvrirTache(t.cle),
        texte:(t.title + " " + (t.description || "") + " " + epic.title)});
    });
  }
  const terme = q.trim().toLowerCase();
  PALETTE_RES = base.filter(x => !terme ||
    (x.titre + " " + (x.texte || "") + " " + (x.groupe || "")).toLowerCase().includes(terme)).slice(0, 9);
  PALETTE_ACTIF = 0;
  dessinerPalette();
}

function dessinerPalette(){
  const liste = $("#paletteListe");
  if(!liste) return;
  liste.innerHTML = PALETTE_RES.length ? PALETTE_RES.map((x, i) => `
    <div class="palette-item ${i === PALETTE_ACTIF ? "on" : ""}" data-i="${i}"
         onclick="executerPalette(${i})">
      ${ICO[x.ico] || ICO.epic}<span>${esc(x.titre)}</span>
      <span class="g">${esc(x.groupe)}</span>
    </div>`).join("")
    : `<div class="palette-vide">Aucun résultat.</div>`;
}

function naviguerPalette(e){
  if(e.key === "Escape"){ e.preventDefault(); fermerPalette(); return; }
  if(e.key === "ArrowDown"){ e.preventDefault();
    PALETTE_ACTIF = Math.min(PALETTE_RES.length - 1, PALETTE_ACTIF + 1); dessinerPalette(); }
  if(e.key === "ArrowUp"){ e.preventDefault();
    PALETTE_ACTIF = Math.max(0, PALETTE_ACTIF - 1); dessinerPalette(); }
  if(e.key === "Enter"){ e.preventDefault(); executerPalette(PALETTE_ACTIF); }
}

function executerPalette(i){
  const x = PALETTE_RES[i];
  if(!x) return;
  fermerPalette();
  x.action();
}


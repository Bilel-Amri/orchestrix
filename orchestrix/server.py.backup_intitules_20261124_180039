/* ── vue : Jira ──────────────────────────────────────────────────── */
function rendreJira(){
  const p = PROJET && PROJET.projet;
  const j = (PROJET && PROJET.jira) || {};
  $("#jEtat").innerHTML = j.configure
    ? `<span class="etat-jira ok"><i></i>Configuré${j.compte ? " — " + esc(j.compte) : ""}</span>`
    : `<span class="etat-jira non"><i></i>Non configuré</span>`;
  if($("#jUrl")) $("#jUrl").value = j.url || "";
  if($("#jEmail")) $("#jEmail").value = j.email || "";
  if($("#jCle")) $("#jCle").value = j.cle_projet || "";
  if($("#jToken")) $("#jToken").placeholder = j.token ? "jeton enregistré (laisser vide)" : "jeton d'API Jira";

  const types = j.types_detectes || [];
  $("#jTypes").innerHTML = types.length
    ? types.map(t => `<span class="chip">${esc(t.nom)}</span>`).join("")
    : `<span class="vide">Lancez « Vérifier la connexion » pour lire les types de ticket du projet.</span>`;

  const res = j.resultats || [];
  $("#jHistorique").innerHTML = res.length ? res.slice().reverse().map(r => `
    <div class="histo"><span>${esc(r.date)}</span>
      <b>${nf(r.crees)} ticket(s) créé(s) · ${(r.erreurs || []).length} erreur(s)</b>
      ${(r.erreurs || []).length ? `<div class="vide">${(r.erreurs || []).slice(0, 3)
        .map(esc).join("<br>")}</div>` : ""}</div>`).join("")
    : `<p class="vide">Aucune synchronisation pour l'instant.</p>`;

  $("#jCompteur").textContent = j.dans_jira
    ? `${j.dans_jira} tâche(s) déjà rattachée(s) à un ticket Jira`
    : "";

  const boutons = ["#jVerifier", "#jEnvoyer", "#jRelire"];
  boutons.forEach(b => { const e = $(b); if(e) e.disabled = !p; });
}


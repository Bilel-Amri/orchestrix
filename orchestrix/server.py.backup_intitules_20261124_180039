    <div class="prop"><dt>Extraits cités</dt><dd>${nf(PREUVES.length)}</dd></div>`;

  $("#anneauCouverture").innerHTML = anneauHTML(couv, "Couverte");
  const fac = textes(a.fonctionnalites);

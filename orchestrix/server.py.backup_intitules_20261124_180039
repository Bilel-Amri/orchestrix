"""Interface graphique locale — bibliothèque standard uniquement.

    python -m orchestrix --ui
    → http://localhost:8402

Pourquoi pas Streamlit ou Flask : aucune dépendance à installer et aucune
installation supplémentaire. Le serveur est un `ThreadingHTTPServer` : il traite
les requêtes lentes (collecte des 9 sources, appel Groq) en arrière-plan pendant
que la page interroge l'avancement, ce qui évite un navigateur figé 60 secondes.
"""

from __future__ import annotations

import json
import threading
import time
from concurrent.futures import ThreadPoolExecutor
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse

PORT_DEFAUT = 8402

# Un job à la fois : le générateur n'est pas réentrant (cache disque, quota API)
_ETAT: dict = {"statut": "idle", "journal": [], "plan": None, "meta": None,
               "erreur": None, "debut": None, "avancement": None,
               "dernier_jeton": None}
_VERROU = threading.Lock()


def _silence() -> float | None:
    """Secondes écoulées depuis le dernier signe de vie du modèle.

    Un flux qui n'envoie plus rien au bout de 45 s ne rédigera rien de plus :
    le serveur a coupé ou la requête est perdue. Le dire vaut mieux que
    laisser un chronomètre tourner sans fin.
    """
    j = _ETAT.get("dernier_jeton")
    if not j:
        return None
    return round(time.perf_counter() - j, 1)


# ──────────────────────────────────────────────────────────────────────
# Génération en arrière-plan
# ──────────────────────────────────────────────────────────────────────
class _Capture:
    """Remplace stdout pendant la génération pour alimenter le journal."""

    def __init__(self) -> None:
        self.lignes: list[str] = []

    def write(self, texte: str) -> None:
        if texte.strip():
            self.lignes.append(texte.rstrip())
            with _VERROU:
                _ETAT["journal"] = list(self.lignes)

    def flush(self) -> None:
        pass


# ──────────────────────────────────────────────────────────────────────
# Traduction des preuves pour l'affichage
# ──────────────────────────────────────────────────────────────────────
def _traduire_textes(textes: list[str], llm) -> list[str]:
    """Traduit une liste d'énoncés en français. Rend les originaux si ça échoue.

    Les preuves et le brief sont des textes réels, majoritairement anglais. Le
    plan, lui, est rédigé en français : laisser ces textes en anglais couperait
    le lecteur au moment précis où il vérifie d'où vient une affirmation.

    Rien n'est inventé : on ne fait que traduire l'existant, et l'URL d'origine
    reste affichée pour vérifier la citation à la source. Si un lot échoue
    (quota, réseau), ses textes gardent leur forme d'origine — un texte anglais
    vaut mieux qu'un texte absent.
    """
    if not textes:
        return []

    def un_lot(lot: list[str]) -> list[str]:
        """Traduit un lot de 20 énoncés ; rend les originaux en cas d'échec."""
        numerote = "\n".join(f"[{i}] {t}" for i, t in enumerate(lot, 1))
        table: dict[int, str] = {}
        try:
            rep = llm.chat_json(
                TRADUIRE_SYSTEM, TRADUIRE_USER.format(preuves=numerote),
                max_tokens=1800, temperature=0.0)
            for item in rep.get("traductions") or []:
                if isinstance(item, dict):
                    try:
                        table[int(item.get("n"))] = str(item.get("texte", "")).strip()
                    except (TypeError, ValueError):
                        continue
        except Exception:                        # noqa: BLE001
            table = {}                           # lot laissé en l'état
        return [table.get(i) or t for i, t in enumerate(lot, 1)]

    # Par lots de 20 : une seule requête pour tout dépasserait MAX_TOKENS.
    # Les lots partent EN PARALLÈLE : quatre requêtes simultanées transforment
    # 4 × 3 s en 3 s. Sans cela, la traduction était le dernier obstacle
    # visible entre « plan prêt » et « plan affiché ».
    lots = [textes[d:d + 20] for d in range(0, len(textes), 20)]
    if len(lots) == 1:
        return un_lot(lots[0])
    with ThreadPoolExecutor(max_workers=min(4, len(lots))) as pool:
        morceaux = list(pool.map(un_lot, lots))
    return [t for morceau in morceaux for t in morceau]


def _appliquer(preuves: list[dict], traduits: list[str]) -> list[dict]:
    """Rend les preuves avec leur traduction, l'original restant accessible."""
    sortie = []
    for p, fr in zip(preuves, traduits):
        q = dict(p)
        if fr and fr != p.get("texte"):
            q["texte_original"] = p.get("texte", "")
            q["texte"] = fr
        sortie.append(q)
    return sortie


def _traduire_preuves(preuves: list[dict], llm, limite: int | None = None) -> list[dict]:
    """Traduit les preuves affichées, en gardant l'original sous la main.

    `limite` ne traite que les N premières : au-delà, les preuves sont rendues
    telles quelles et traduites ensuite, en tâche de fond (voir
    `_traduire_reste`). L'utilisateur lit rarement plus de douze citations
    avant de décider si le plan tient debout ; le reste peut attendre.
    """
    from . import config
    if not preuves or not config.TRADUIRE_PREUVES:
        return preuves
    cible = preuves if limite is None else preuves[:limite]
    if not cible:
        return preuves
    traduits = _traduire_textes([str(p.get("texte", "")) for p in cible], llm)
    return _appliquer(cible, traduits) + [dict(p) for p in preuves[len(cible):]]


def _traduire_reste(preuves: list[dict], llm) -> list[dict]:
    """Traduit TOUTES les preuves (utilisé pour la passe de fond)."""
    from . import config
    if not preuves or not config.TRADUIRE_PREUVES:
        return preuves
    traduits = _traduire_textes([str(p.get("texte", "")) for p in preuves], llm)
    return _appliquer(preuves, traduits)


def _brief_affiche(brief: str, llm) -> str:
    """Version française du brief, pour l'entête du backlog.

    Le brief est la demande du chef de projet : si elle est écrite en anglais,
    l'afficher telle quelle dans une page française détonne. On garde
    l'original à disposition (`brief_original`) et on affiche la traduction.
    """
    from . import config
    from .agent import _langue
    if not config.TRADUIRE_PREUVES or _langue(brief) != "en":
        return brief
    return _traduire_textes([brief], llm)[0] or brief


TRADUIRE_SYSTEM = """Tu traduis en français des extraits de documents techniques.

On te donne une liste numérotée d'énoncés, souvent en anglais. Traduis chacun
en français naturel et concis, en gardant le sens exact et le niveau de détail.
Ne résume pas, n'ajoute rien, ne commente pas. Un nom de produit ou une marque
reste tel quel. Réponds uniquement en JSON :
{"traductions": [{"n": 1, "texte": "traduction française"}]}
"""

TRADUIRE_USER = """ÉNONCÉS À TRADUIRE :
{preuves}

JSON uniquement."""


def _generer(brief: str, motif: str = "") -> None:
    from .agent import Orchestrix
    from .llm import GroqClient, GroqError

    capture = _Capture()
    import sys
    ancien = sys.stdout
    sys.stdout = capture              # type: ignore[assignment]
    try:
        llm = GroqClient()

        agent = Orchestrix(llm=llm, verbose=True)

        def suivre(infos: dict) -> None:
            """Recopie l'avancement dans l'état lu par la page."""
            with _VERROU:
                _ETAT["avancement"] = {
                    "etape": infos.get("etape", ""),
                    "jetons": int(infos.get("jetons") or 0),
                }
                if infos.get("jetons"):
                    _ETAT["dernier_jeton"] = time.perf_counter()

        agent.sur_progression = suivre
        resultat = agent.run(brief, motif_rejet=motif)
        agent.sauver(resultat, "out")

        # ── le plan est prêt : on l'affiche TOUT DE SUITE ─────────────
        # La traduction des preuves et du brief ajoutait plusieurs secondes
        # après la fin du travail utile. Elle se fait maintenant derrière, et
        # la page se remplit sans que l'utilisateur attende.
        meta = dict(resultat.metadonnees)
        with _VERROU:
            _ETAT["plan"] = resultat.plan
            _ETAT["meta"] = meta
            _ETAT["preuves"] = resultat.pack.preuves
            _ETAT["statut"] = "traduction"
            _ETAT["avancement"] = {"etape": "traduction des preuves", "jetons": 0}
        from . import config
        immédiat = max(1, int(config.PREUVES_TRADUITES_IMMEDIAT))
        print(f"⑩ traduction des preuves (les {immédiat} premières, puis en fond)",
              flush=True)

        with ThreadPoolExecutor(max_workers=2) as pool:
            f_preuves = pool.submit(_traduire_preuves, resultat.pack.preuves,
                                    llm, immédiat)
            f_brief = pool.submit(_brief_affiche, brief, llm)
            preuves = f_preuves.result()
            brief_fr = f_brief.result()

        if brief_fr != brief:
            meta["brief_original"] = brief
            meta["brief"] = brief_fr
        with _VERROU:
            _ETAT["preuves"] = preuves
            _ETAT["meta"] = meta
            _ETAT["statut"] = "termine"

        # ── le reste des preuves se traduit derrière ──────────────────
        # La page est déjà utilisable : ce fil ne retarde plus personne, et
        # `/api/plan` servira les citations traduites au rechargement suivant.
        toutes = resultat.pack.preuves
        if len(toutes) > immédiat:
            def finir():
                try:
                    complet = _traduire_reste(toutes, llm)
                except Exception:            # noqa: BLE001
                    return
                with _VERROU:
                    if _ETAT["plan"] is resultat.plan:
                        _ETAT["preuves"] = complet
            threading.Thread(target=finir, daemon=True).start()
    except GroqError as exc:
        with _VERROU:
            _ETAT["erreur"] = str(exc)
            _ETAT["statut"] = "erreur"
    except Exception as exc:                     # noqa: BLE001
        with _VERROU:
            _ETAT["erreur"] = f"{type(exc).__name__} : {exc}"
            _ETAT["statut"] = "erreur"
    finally:
        sys.stdout = ancien
        with _VERROU:
            if _ETAT["statut"] not in ("termine", "erreur"):
                _ETAT["statut"] = "erreur"
                _ETAT["erreur"] = "génération interrompue"


# ──────────────────────────────────────────────────────────────────────
# HTTP
# ──────────────────────────────────────────────────────────────────────
class _Handler(BaseHTTPRequestHandler):
    def log_message(self, *a) -> None:           # silence dans la console
        pass

    # ── helpers ─────────────────────────────────────────────────────
    def _envoyer(self, code: int, corps: bytes, type_: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", type_)
        self.send_header("Content-Length", str(len(corps)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(corps)

    def _json(self, donnees: dict, code: int = 200) -> None:
        self._envoyer(code, json.dumps(donnees, ensure_ascii=False).encode(),
                      "application/json; charset=utf-8")

    def _html(self, texte: str) -> None:
        self._envoyer(200, texte.encode(), "text/html; charset=utf-8")

    # ── routes ──────────────────────────────────────────────────────
    def do_GET(self) -> None:                    # noqa: N802
        chemin = urlparse(self.path).path

        if chemin in ("/", "/index.html"):
            self._html(PAGE)

        elif chemin == "/api/etat":
            with _VERROU:
                self._json({
                    "statut": _ETAT["statut"],
                    "journal": _ETAT["journal"][-400:],
                    "erreur": _ETAT["erreur"],
                    "duree": (round(time.perf_counter() - _ETAT["debut"], 1)
                              if _ETAT["debut"] else None),
                    "pret": bool(_ETAT["plan"]),
                    "avancement": _ETAT["avancement"],
                    "silence": _silence(),
                })

        elif chemin == "/api/plan":
            with _VERROU:
                if not _ETAT["plan"]:
                    self._json({"erreur": "aucun plan généré"}, 404)
                    return
                self._json({"plan": _ETAT["plan"], "meta": _ETAT["meta"],
                            "preuves": _ETAT.get("preuves") or []})

        elif chemin == "/api/projet":
            from . import gestion
            self._json(gestion.vue_publique(gestion.charger()))

        elif chemin == "/api/reglages":
            from . import reglages
            from .llm import GroqError, GroqClient
            cle = reglages.cle_effective()
            hors = {}
            try:
                modele = GroqClient().model
            except GroqError as exc:
                modele = ""
                hors["erreur"] = str(exc)
            except Exception as exc:                 # noqa: BLE001
                modele = ""
                hors["erreur"] = f"{type(exc).__name__} : {exc}"
            self._json({
                "cle_presente": bool(cle),
                "cle_masquee": reglages.masque(cle) if cle else "",
                "source": reglages.source_cle(),
                "modele": modele,
                **hors,
            })

        elif chemin == "/api/journal":
            from . import gestion
            etat = gestion.charger()
            self._json({"journal": etat.get("journal") or []})

        elif chemin == "/api/export":
            with _VERROU:
                plan, meta = _ETAT["plan"], _ETAT["meta"]
            if not plan:
                self._json({"erreur": "aucun plan"}, 404)
                return
            from .agent import Resultat
            from .evidence import EvidencePack

            class _Vide:
                passages, fonctionnalites, preuves = [], [], []

            r = Resultat(plan=plan, pack=_Vide(), metadonnees=meta)  # type: ignore[arg-type]
            self._envoyer(200, r.to_markdown().encode(), "text/markdown; charset=utf-8")

        else:
            self._envoyer(404, b"introuvable", "text/plain")

    def do_POST(self) -> None:                   # noqa: N802
        chemin = urlparse(self.path).path

        taille = int(self.headers.get("Content-Length") or 0)
        try:
            corps = json.loads(self.rfile.read(taille) or b"{}")
        except json.JSONDecodeError:
            self._json({"erreur": "JSON invalide"}, 400)
            return

        if chemin == "/api/reglages":
            from . import reglages
            cle = str(corps.get("cle") or "").strip()
            if corps.get("effacer"):
                reglages.effacer_cle()
                self._json({"ok": True, "cle_presente": bool(reglages.cle_effective())})
                return
            if cle:
                if not cle.startswith("gsk_"):
                    self._json({"erreur": "une clé Groq commence par « gsk_ ». "
                                          "Vérifiez le copier-coller."}, 400)
                    return
                reglages.enregistrer_cle(cle)
            self._json({"ok": True, "cle_presente": bool(reglages.cle_effective()),
                        "source": reglages.source_cle()})
            return

        if chemin.startswith("/api/projet/") or chemin.startswith("/api/jira/"):
            self._route_plateforme(chemin, corps)
            return

        if chemin != "/api/generer":
            self._envoyer(404, b"introuvable", "text/plain")
            return

        brief = str(corps.get("brief", "")).strip()
        motif = str(corps.get("motif") or "").strip()
        if not brief:
            # régénération après rejet : on repart du brief du projet rejeté
            from . import gestion as _g
            proj = (_g.charger().get("projet") or {})
            brief = str(proj.get("brief") or "").strip()
            if not motif:
                motif = str((_g.charger().get("validation") or {}).get("motif") or "")

        if len(brief) < 10:
            self._json({"erreur": "le brief est trop court (10 caractères min)"}, 400)
            return

        with _VERROU:
            if _ETAT["statut"] in ("en_cours", "traduction"):
                self._json({"erreur": "une génération est déjà en cours"}, 409)
                return
            _ETAT.update({"statut": "en_cours", "journal": [], "plan": None,
                          "meta": None, "erreur": None, "preuves": [],
                          "avancement": None, "dernier_jeton": time.perf_counter(),
                          "debut": time.perf_counter()})

        threading.Thread(target=_generer, args=(brief, motif), daemon=True).start()
        self._json({"ok": True})


# ──────────────────────────────────────────────────────────────────────
# Routes de gestion de projet (création, équipe, affectation, exécution)
# ──────────────────────────────────────────────────────────────────────
def _route_plateforme(self, chemin: str, corps: dict) -> None:  # noqa: C901
    from . import gestion

    def repondre(etat: dict) -> None:
        self._json(gestion.vue_publique(etat))

    try:
        # ── créer le projet depuis le plan généré ──────────────────
        if chemin == "/api/projet/creer":
            with _VERROU:
                plan, meta = _ETAT["plan"], _ETAT["meta"]
            if not plan:
                self._json({"erreur": "aucun plan généré : lancez d'abord une "
                                      "génération depuis un brief."}, 400)
                return
            etat = gestion.creer_projet(plan, meta or {}, str(corps.get("nom") or ""))
            if corps.get("equipe"):
                etat = gestion.definir_equipe(etat, corps["equipe"])
            repondre(etat)

        # ── équipe ─────────────────────────────────────────────────
        elif chemin == "/api/projet/equipe":
            etat = gestion.definir_equipe(gestion.charger(), corps.get("membres") or [])
            repondre(etat)

        # ── affectation ────────────────────────────────────────────
        elif chemin == "/api/projet/affecter":
            etat = gestion.charger()
            etat = gestion.affecter(etat, str(corps.get("cle") or ""),
                                    corps.get("membre") or None)
            repondre(etat)

        elif chemin == "/api/projet/repartir":
            repondre(gestion.repartir_automatiquement(
                gestion.charger(), forcer=bool(corps.get("forcer"))))

        elif chemin == "/api/projet/soumettre":
            repondre(gestion.soumettre(gestion.charger(),
                                       str(corps.get("auteur") or "")))

        elif chemin == "/api/projet/approuver":
            repondre(gestion.approuver(gestion.charger(),
                                       str(corps.get("auteur") or "")))

        elif chemin == "/api/projet/rejeter":
            etat = gestion.rejeter(gestion.charger(), str(corps.get("motif") or ""),
                                   str(corps.get("auteur") or ""))
            repondre(etat)

        # ── exécution ──────────────────────────────────────────────
        elif chemin == "/api/projet/statut":
            etat = gestion.charger()
            etat = gestion.changer_statut(etat, str(corps.get("cle") or ""),
                                          str(corps.get("statut") or ""),
                                          str(corps.get("auteur") or ""))
            repondre(etat)

        elif chemin == "/api/projet/commenter":
            etat = gestion.charger()
            etat = gestion.commenter(etat, str(corps.get("cle") or ""),
                                     str(corps.get("texte") or ""),
                                     str(corps.get("auteur") or ""))
            repondre(etat)

        elif chemin == "/api/projet/reinitialiser":
            etat = gestion.charger()
            etat["projet"] = None
            etat["taches"] = {}
            gestion.journaliser(etat, "projet supprimé")
            gestion.sauver(etat)
            repondre(etat)

        # ── Jira ───────────────────────────────────────────────────
        elif chemin == "/api/jira/config":
            etat = gestion.charger()
            jira = etat.setdefault("jira", {})
            for champ in ("url", "email", "cle_projet"):
                if champ in corps:
                    jira[champ] = str(corps.get(champ) or "").strip()
            # un jeton masqué renvoyé par l'interface ne doit pas écraser le vrai
            jeton = str(corps.get("token") or "")
            if jeton and "•" not in jeton:
                jira["token"] = jeton
            elif corps.get("effacer_jeton"):
                jira["token"] = ""
            gestion.sauver(etat)
            repondre(etat)

        elif chemin == "/api/reglages/tester":
            from . import reglages
            from .llm import GroqError, GroqClient
            if not reglages.cle_effective():
                self._json({"erreur": "aucune clé enregistrée"}, 400)
                return
            try:
                llm = GroqClient()
                modeles = llm.lister_modeles()
                self._json({"ok": True, "modele": llm.model,
                            "modeles": modeles[:12],
                            "source": reglages.source_cle()})
            except GroqError as exc:
                self._json({"erreur": str(exc)}, 400)
            except Exception as exc:                 # noqa: BLE001
                self._json({"erreur": f"{type(exc).__name__} : {exc}"}, 500)

        elif chemin == "/api/jira/verifier":
            from . import jira as jira_mod
            etat = gestion.charger()
            cfg = etat.get("jira") or {}
            info = jira_mod.verifier(cfg.get("url", ""), cfg.get("email", ""),
                                     cfg.get("token", ""), cfg.get("cle_projet", ""))
            etat["jira"]["types_detectes"] = info["types"]
            etat["jira"]["compte"] = info["compte"]
            gestion.sauver(etat)
            self._json({"ok": True, "info": info,
                        "etat": gestion.vue_publique(etat)})

        elif chemin == "/api/jira/envoyer":
            from . import jira as jira_mod
            etat = gestion.charger()
            if not etat.get("projet"):
                self._json({"erreur": "aucun projet : créez-le avant d'envoyer vers Jira."}, 400)
                return
            with _VERROU:
                plan = _ETAT["plan"]
            if not plan:
                self._json({"erreur": "le plan n'est plus en mémoire — relancez une génération."}, 400)
                return
            res = jira_mod.creer_tickets(
                plan, etat.get("taches") or {}, etat.get("jira") or {},
                progresser=lambda t: gestion.journaliser(etat, "Jira — " + t))
            for notre, cle_jira in (res.get("liens") or {}).items():
                if notre in etat["taches"]:
                    etat["taches"][notre]["jira"] = cle_jira
            etat["jira"]["derniere_sync"] = gestion._maintenant()
            etat["jira"]["resultats"] = (
                ((etat["jira"].get("resultats") or []) +
                 [{"date": gestion._maintenant(), "crees": len(res["crees"]),
                   "erreurs": res["erreurs"][:20],
                   "epics": len(res.get("epics") or {})}])[-40:])
            gestion.journaliser(etat, f"Jira : {len(res['crees'])} ticket(s) créé(s), "
                                      f"{len(res['erreurs'])} erreur(s)")
            gestion.sauver(etat)
            self._json({"ok": True, "crees": res["crees"], "erreurs": res["erreurs"],
                        "etat": gestion.vue_publique(etat)})

        elif chemin == "/api/jira/relire":
            from . import jira as jira_mod
            etat = gestion.charger()
            liens = {k: v.get("jira") for k, v in (etat.get("taches") or {}).items()
                     if v.get("jira")}
            res = jira_mod.relire(etat.get("jira") or {}, liens)
            n = jira_mod.appliquer(etat.get("taches") or {}, res.get("tickets") or [])
            etat["jira"]["derniere_sync"] = gestion._maintenant()
            gestion.journaliser(etat, f"Jira : relecture, {n} changement(s)")
            gestion.sauver(etat)
            self._json({"ok": True, "changements": n, "erreurs": res.get("erreurs") or [],
                        "etat": gestion.vue_publique(etat)})

        else:
            self._envoyer(404, b"introuvable", "text/plain")

    except KeyError as exc:
        self._json({"erreur": f"tâche inconnue : {exc}"}, 404)
    except ValueError as exc:
        self._json({"erreur": str(exc)}, 400)
    except Exception as exc:                     # noqa: BLE001
        from .llm import GroqError
        from .jira import JiraErreur
        if isinstance(exc, (JiraErreur, GroqError)):
            self._json({"erreur": str(exc)}, 400)
        else:
            self._json({"erreur": f"{type(exc).__name__} : {exc}"}, 500)


_Handler._route_plateforme = _route_plateforme


# ──────────────────────────────────────────────────────────────────────
def _prechauffer() -> None:
    """Prépare la connexion Groq pendant que l'utilisateur lit la page.

    Sans cela, la première génération payait la découverte des modèles et la
    poignée de main TLS avant de commencer à travailler. Fait au démarrage du
    serveur, ce coût disparaît du temps perçu.
    """
    def tache() -> None:
        try:
            from .llm import GroqClient
            GroqClient().prechauffer()
        except Exception:                        # noqa: BLE001
            pass                                 # clé absente : la page le dira

    threading.Thread(target=tache, daemon=True).start()


def servir(port: int = PORT_DEFAUT, ouvrir: bool = True) -> None:
    serveur = ThreadingHTTPServer(("0.0.0.0", port), _Handler)
    _prechauffer()
    url = f"http://localhost:{port}"
    print(f"🖥  Interface Orchestrix — {url}")
    print("   Ctrl+C pour arrêter.\n")
    if ouvrir:
        threading.Timer(0.6, lambda: webbrowser.open(url)).start()
    try:
        serveur.serve_forever()
    except KeyboardInterrupt:
        print("\n⏹  arrêt.")
    finally:
        serveur.server_close()



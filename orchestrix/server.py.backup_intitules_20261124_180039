  setTimeout(() => { const n = $("#nomProjet"); if(n) n.focus(); }, 250);
}

$("#filVue").textContent = "Brief";
$("#btnExport").classList.add("cache");
fetch("/api/etat").then(r => r.json()).then(e => {
  if(e && e.statut === "termine") charger();
}).catch(() => {});

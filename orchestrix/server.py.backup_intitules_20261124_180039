<script>
"use strict";
const $  = s => document.querySelector(s);
const $$ = s => Array.from(document.querySelectorAll(s));
const esc = t => String(t == null ? "" : t)
  .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const nf  = n => Number(n || 0).toLocaleString("fr-FR");
const pct = (n, d) => d ? Math.round(n / d * 100) : 0;

/* Le modèle renvoie parfois une phrase là où l'on attend une liste
   (« utilisateurs » : "les gestionnaires, les acheteurs"). Ces deux fonctions
   évitent qu'un plan valide fasse planter l'affichage. */
const liste = v => {
  if(Array.isArray(v)) return v.filter(x => x != null && String(x).trim() !== "");
  if(v == null) return [];
  if(typeof v === "string"){
    const t = v.trim();
    if(!t) return [];
    return t.split(/\s*[;·•]\s*|\s+et\s+|,\s*/).map(x => x.trim())
            .filter(x => x.length > 0);
  }
  if(typeof v === "object") return Object.values(v).map(x => String(x));
  return [String(v)];
};
/* liste de textes : garantit que chaque élément est une chaîne affichable */
const textes = v => liste(v).map(x => typeof x === "object" && x !== null
  ? (x.texte || x.titre || x.nom || JSON.stringify(x)) : String(x));

const TYPES = {dev:"Développement", test:"Tests", config:"Configuration",
               doc:"Documentation", design:"Conception", securite:"Sécurité"};
const typeLib = t => TYPES[t] || t || "—";
const COUL_TYPE = {dev:"#0f62fe", design:"#6929c4", config:"#007d79",
                   test:"#1192e8", doc:"#8b95a3", securite:"#da1e28"};
const PREUVE_LIB = {fonctionnalite:"Fonctionnalité", exigence:"Exigence", extrait:"Extrait"};
const VUES = {saisie:"Brief", plan:"Synthèse", backlog:"Backlog", tableau:"Tableau",
              qualite:"Contrôles", planification:"Planification", risques:"Risques",
              espace:"Espace de travail", execution:"Exécution", jira:"Jira",
              sources:"Sources", reglages:"Réglages"};

let PLAN = null, META = null, PREUVES = [], MINUTEUR = null, VUE = "saisie";
let PLAN_AFFICHE = false;
let FILTRE_TYPE = "", Q = "", TOUT_OUVERT = false;

/* ── icônes ──────────────────────────────────────────────────────── */
const ICO = {
  epic: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="6" height="6" rx="1.6"/><rect x="11" y="3" width="6" height="4" rx="1.6"/><rect x="11" y="9" width="6" height="8" rx="1.6"/><rect x="3" y="11" width="6" height="6" rx="1.6"/></svg>',
  story: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 4.5h12v9H9.5L6 17v-3.5H4z" stroke-linejoin="round"/></svg>',
  task: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 10.5l3.4 3.4L16 5.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  pts: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M10 2.8l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L2.8 8.1l5-.7z" stroke-linejoin="round"/></svg>',
  anc: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M10 3.5v10M6.5 7 10 3.5 13.5 7M5 13c1.4 2 3 3 5 3s3.6-1 5-3" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  couv: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10" cy="10" r="6.8"/><path d="M10 3.2v13.6M3.2 10h13.6" stroke-linecap="round" opacity=".5"/><path d="M10 10 16.4 6.6A7 7 0 0 1 17 10z" fill="currentColor" stroke="none" opacity=".9"/></svg>',
  doc: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4.5 3.5h7L15.5 7v9.5h-11z" stroke-linejoin="round"/><path d="M11.3 3.6V7h3.6" stroke-linejoin="round"/></svg>',
  ok: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.2 8.4 6.2 11.4 12.8 4.8"/></svg>',
  ko: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M8 3.6v5.2M8 12.1v.1"/></svg>',
  alerte: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 3.2 18 17H2z" stroke-linejoin="round"/><path d="M10 8.2v3.6M10 14.6v.1"/></svg>'
};

/* ── navigation ──────────────────────────────────────────────────── */
function aller(v){
  /* la saisie et les réglages restent accessibles sans plan : on doit pouvoir
     enregistrer sa clé avant même d'avoir généré quoi que ce soit */
  if(v !== "saisie" && v !== "reglages" && !PLAN) return;
  VUE = v;
  $$("section[id^='vue-']").forEach(s => s.classList.add("cache"));
  const c = $("#vue-" + v);
  if(c) c.classList.remove("cache");
  $$(".rail-nav button").forEach(b => b.classList.toggle("actif", b.dataset.vue === v));
  $$(".onglets button").forEach(b => b.classList.toggle("actif", b.dataset.vue === v));
  $("#filVue").textContent = VUES[v] || v;
  if(v !== "saisie") $("#filNom").textContent = sujetCourt(52);
  const bp = $("#barreProjet");
  if(bp) bp.textContent = PLAN ? "· " + sujetCourt(46) : "· Pilotage de projet";
  window.scrollTo({top:0, behavior:"smooth"});
}
$$(".rail-nav button").forEach(b => b.onclick = () => aller(b.dataset.vue));

/* ── onglets de modules (mêmes sources que le rail) ──────────────── */
function construireOnglets(){
  const rail = $$(".rail-nav button");
  const barre = $("#onglets");
  const ordre = ["saisie","plan","espace","execution","backlog","tableau","jira",
                 "qualite","planification","risques","sources","reglages"];
  const parVue = {};
  rail.forEach(b => { if(b.dataset.vue) parVue[b.dataset.vue] = b; });
  barre.innerHTML = "";
  ordre.forEach(v => {
    const src = parVue[v];
    if(!src) return;
    const b = document.createElement("button");
    b.type = "button";
    b.dataset.vue = v;
    if(src.dataset.plan) b.dataset.plan = "1";
    b.disabled = src.disabled;
    b.textContent = (VUES[v] || src.textContent).trim();
    b.onclick = () => aller(v);
    barre.appendChild(b);
  });
  aller(VUE || "saisie");
}
construireOnglets();

function sujetCourt(n){
  const s = (META && META.analyse && META.analyse.sujet) || (META && META.brief) || "Nouveau projet";
  return s.length > n ? s.slice(0, n).trimEnd() + "…" : s;
}

/* ── compteur ────────────────────────────────────────────────────── */
function majCompteur(){
  const n = $("#brief").value.trim().length;
  const c = $("#compteur");
  c.innerHTML = n >= 10 ? `<b>${nf(n)}</b> caractères — prêt à générer`
                        : `<b>${nf(n)}</b> caractère${n > 1 ? "s" : ""} — 10 minimum`;
  c.classList.toggle("ok", n >= 10);
}
$("#brief").addEventListener("input", majCompteur);
majCompteur();

$$(".tuile[data-aller]").forEach(t => t.onclick = () => aller(t.dataset.aller));
$$(".ex").forEach(b => b.onclick = () => {
  $("#brief").value = b.dataset.b; majCompteur(); $("#brief").focus();
});

/* ── réinitialisation ────────────────────────────────────────────── */
$("#btnNouveau").onclick = () => {
  PLAN = null; META = null; PREUVES = []; Q = ""; FILTRE_TYPE = "";
  $("#recherche").value = "";
  $$(".rail-nav button[data-plan], .onglets button[data-plan], .tuile[data-plan]").forEach(b => b.disabled = true);
  $("#btnExport").classList.add("cache");
  $("#zoneRecherche").style.opacity = ".45";
  $("#railSujet").textContent = "Aucun projet chargé";
  $("#railSub").textContent = "Décrivez un brief pour démarrer";
  $("#railJauge").style.width = "0%";
  $("#railProjet").classList.add("off");
  $("#filNom").textContent = "Nouveau projet";
  $("#railModele").textContent = "—"; $("#railDate").textContent = "—";
  $("#piedInfo").textContent = "Aucun plan chargé";
  ["bBacklog","bTableau","bSources","bRisques","bEquipe","bExec"].forEach(
    i => { const e = $("#" + i); if(e) e.textContent = ""; });
  $("#brief").value = ""; majCompteur();
  $("#zoneErreur").innerHTML = "";
  aller("saisie");
};
$("#btnExport").onclick = () => window.open("/api/export", "_blank");

/* ── génération ──────────────────────────────────────────────────── */
$("#btnGenerer").onclick = () => {
  const brief = $("#brief").value.trim();
  if(brief.length < 10){ $("#brief").focus(); return; }
  $("#btnGenerer").disabled = true;
  $("#zoneErreur").innerHTML = "";
  $("#attente").classList.remove("cache");
  reinitialiserAttente();
  const t0 = Date.now();
  fetch("/api/generer", {method:"POST", headers:{"Content-Type":"application/json"},
        body:JSON.stringify({brief})})
    .then(r => r.json()).then(d => {
      if(d.erreur){ arreter(); erreur(d.erreur); return; }
      MINUTEUR = setInterval(() => sonder(t0), 900);
    })
    .catch(e => { arreter(); erreur("Connexion au serveur impossible : " + e); });
};

function arreter(){
  clearInterval(MINUTEUR);
  $("#attente").classList.add("cache");
  $("#btnGenerer").disabled = false;
  PLAN_AFFICHE = false;
}
function masquerAttente(){ $("#attente").classList.add("cache"); }

/* L'avancement réel remplace le sablier muet.
   Un plan fait 6 000 à 12 000 jetons : le modèle en écrit environ 300 par
   seconde. Afficher le compteur qui monte, plutôt qu'une barre qui tourne
   sans fin, dit à l'utilisateur que le travail avance — et de combien. */
const ETAPES_POIDS = [
  ["analyse du besoin",   0,   .08],
  ["collecte des sources", .08, .20],
  ["rédaction du plan",    .20, .90],
  ["correction du plan",   .90, .96],
  ["traduction des preuves", .96, 1  ],
];
const ETAPES_LIBELLES = {
  "analyse du besoin":"Analyse du besoin",
  "collecte des sources":"Collecte des 9 sources",
  "rédaction du plan":"Rédaction du plan",
  "correction du plan":"Correction du plan",
  "traduction des preuves":"Traduction des preuves",
};
function majAttente(e, t0){
  const a = (e && e.avancement) || {};
  const etape = a.etape || "démarrage";
  const span = ETAPES_POIDS.find(x => x[0] === etape) || ["démarrage", 0, .06];
  let part = 0;
  if(etape === "rédaction du plan" || etape === "correction du plan"){
    part = Math.min(.93, (a.jetons || 0) / 8000);
  }
  const frac = span[1] + (span[2] - span[1]) * part;
  const j = $("#jaugeAttente");
  if(j){ j.classList.add("mesure"); j.style.width = Math.round(frac * 100) + "%"; }
  const et = $("#etapeTxt");
  const muet = e && e.silence != null && e.silence > 45;
  if(et){
    if(muet){
      /* Aucun jeton depuis 45 s : le flux est coupé. Dire ce qu'on fait
         plutôt que laisser un chronomètre tourner sans explication. */
      et.textContent = "Aucune réponse du modèle depuis " +
        Math.round(e.silence) + " s — nouvel essai en cours…";
      et.style.color = "var(--bordeaux)";
    } else {
      et.textContent = (ETAPES_LIBELLES[etape] || "Démarrage") +
        (a.jetons ? " · " + nf(a.jetons) + " jetons écrits" : "…");
      et.style.color = "";
    }
  }
  const ch = $("#chronoTxt");
  if(ch && t0) ch.textContent = Math.round((Date.now() - t0) / 1000) + " s";
}
function reinitialiserAttente(){
  PLAN_AFFICHE = false;
  const j = $("#jaugeAttente");
  if(j){ j.classList.remove("mesure"); j.style.width = "0"; }
  const et = $("#etapeTxt"); if(et) et.textContent = "Démarrage…";
  const ch = $("#chronoTxt"); if(ch) ch.textContent = "0 s";
}
function erreur(t){
  $("#zoneErreur").innerHTML =
    `<div class="alerte erreur">${ICO.alerte}<div><b>La génération a échoué.</b>${esc(t)}</div></div>`;
}
function sonder(t0){
  fetch("/api/etat").then(r => r.json()).then(e => {
    majAttente(e, t0);
    if(e.statut === "termine"){
      arreter(); charger();
    } else if(e.statut === "erreur"){
      arreter(); erreur(e.erreur || "cause inconnue");
    } else if(e.statut === "traduction" && e.pret && !PLAN_AFFICHE){
      /* Le plan est écrit : il s'affiche pendant que les preuves se
         traduisent. L'utilisateur n'attend plus une étape qui ne le concerne
         pas, et le sondage continue jusqu'à « termine » pour rafraîchir. */
      PLAN_AFFICHE = true;
      masquerAttente();
      charger().then(() => aller("plan"));
    }
  }).catch(() => {});
}

/* ── chargement ──────────────────────────────────────────────────── */
function charger(){
  return fetch("/api/plan").then(r => r.json()).then(d => appliquerDonnees(d))
    .catch(e => erreur("Lecture du plan impossible : " + e));
}

/* applique un plan déjà chargé : sépare la lecture réseau de l'affichage */
function appliquerDonnees(d){
    if(!d || !d.plan){ erreur("Aucun plan disponible sur le serveur."); return; }
    PLAN = d.plan; META = d.meta || {}; PREUVES = d.preuves || [];
    const a = META.analyse || {};
    const sujet = a.sujet || (META.brief || "").slice(0, 90) || "Projet sans titre";
    $("#railSujet").textContent = sujet;
    $("#railSub").textContent = (a.domaine ? a.domaine + " · " : "") +
      nf((META.qualite || {}).points) + " points";
    $("#railJauge").style.width = "100%";
    $("#railProjet").classList.remove("off");
    $("#filNom").textContent = sujetCourt(52);
    $("#railModele").textContent = String(META.modele || "—").split("/").pop();
    $("#railDate").textContent = META.date || "—";
    $("#piedInfo").textContent = "Plan généré le " + (META.date || "—");
    $$(".rail-nav button[data-plan], .onglets button[data-plan], .tuile[data-plan]").forEach(b => b.disabled = false);
    $("#btnExport").classList.remove("cache");
    $("#zoneRecherche").style.opacity = "1";
    /* Chaque vue est rendue indépendamment : si une seule échoue sur une
       donnée inattendue, les autres s'affichent quand même et l'erreur est
       signalée comme un défaut d'affichage, pas comme un échec de génération. */
    const pannes = [];
    [["Synthèse", rendrePlan], ["Backlog", rendreBacklog], ["Tableau", rendreTableau],
     ["Contrôles", rendreQualite], ["Planification", rendrePlanification],
     ["Risques", rendreRisques], ["Sources", rendreSources]]
      .forEach(([nom, fn]) => {
        try { fn(); } catch(e){ pannes.push(nom + " : " + e.message); console.error(nom, e); }
      });
    try { $("#nomProjet").value = sujet; } catch(e){}
    try { majBadges(); } catch(e){}
    if(pannes.length){
      $("#zoneAvert").innerHTML = `<div class="alerte erreur" style="margin-bottom:16px">
        ${ICO.alerte}<div><b>Certaines vues n'ont pas pu être affichées</b>
        ${pannes.map(esc).join("<br>")}<br>Le plan est bien généré : c'est
        l'affichage d'une donnée inhabituelle qui a bloqué.</div></div>`;
    }
    try { aller("plan"); } catch(e){ aller("saisie"); }
}

function majBadges(){
  if(!PLAN) return;
  const q = META.qualite || {};
  $("#bBacklog").textContent = nf(q.taches);
  $("#bTableau").textContent = nf(q.taches);
  $("#bSources").textContent = nf(PREUVES.length);
  const nbR = construireRisques().length;
  $("#bRisques").textContent = nf(nbR);
  $("#bRisques").style.background = nbR >= 4 ? "rgba(225,29,72,.28)" : "rgba(255,255,255,.08)";
  if(nbR >= 4) $("#bRisques").style.color = "#fecdd3";
}

/* ── outils de calcul ────────────────────────────────────────────── */
function toutesLesTaches(){
  const out = [];
  (PLAN.epics || []).forEach((e, i) => (e.stories || []).forEach(s =>
    (s.tasks || []).forEach(t => out.push({t, story: s, epic: e, iEpic: i}))));
  return out;
}
function tachesEpic(e){
  return (e.stories || []).reduce(
    (total, story) => total + (story.tasks || []).length, 0
  );
}
function compteParType(){
  const c = {};
  toutesLesTaches().forEach(({t}) => { c[t.type || "dev"] = (c[t.type || "dev"] || 0) + 1; });
  return c;
}
function compteParPriorite(){
  const c = {"Haute":0, "Moyenne":0, "Basse":0};
  toutesLesTaches().forEach(({t}) => { if(t.priorite in c) c[t.priorite]++; });
  return c;
}

/* anneau SVG */
function anneauHTML(valeur, libelle, taille){
  const t = taille || 112, r = (t - 13) / 2, c = 2 * Math.PI * r;
  const v = Math.max(0, Math.min(100, valeur || 0));
  const teinte = v >= 70 ? "#0e7b45" : v >= 40 ? "#b54708" : "#b42318";
  return `<svg width="${t}" height="${t}" viewBox="0 0 ${t} ${t}">
      <circle cx="${t/2}" cy="${t/2}" r="${r}" fill="none" stroke="#e3e6eb" stroke-width="9"/>
      <circle cx="${t/2}" cy="${t/2}" r="${r}" fill="none" stroke="${teinte}" stroke-width="9"
              stroke-linecap="round" stroke-dasharray="${c}"
              stroke-dashoffset="${c - c * v / 100}" style="transition:stroke-dashoffset .6s"/>
    </svg>
    <div class="cent"><b>${Math.round(v)}<small style="font-size:13px;font-weight:600">%</small></b>
      <span>${esc(libelle)}</span></div>`;
}

/* ── vue : synthèse ──────────────────────────────────────────────── */
function rendrePlan(){
  const a = META.analyse || {}, q = META.qualite || {}, p = META.pipeline || {};
  $("#sujetProjet").textContent = a.sujet || "Projet sans titre";
  $("#objectifProjet").textContent = a.objectif || META.brief || "";
  $("#mDomaine").textContent = a.domaine || "—";
  $("#mDate").textContent = META.date || "—";
  $("#mModele").textContent = String(META.modele || "—").split("/").pop();
  const nbUsers = textes(a.utilisateurs).length, nbFonc = textes(a.fonctionnalites).length;
  $("#mPerimetre").textContent = `${nbUsers} profil${nbUsers > 1 ? "s" : ""} · ${nbFonc} fonctionnalité${nbFonc > 1 ? "s" : ""}`;

  const anc = Math.round((q.taux_ancrage || 0) * 100);
  const couv = Math.round((q.couverture || 0) * 100);
  const kpis = [
    [q.epics, "Épics", "Regroupements fonctionnels", "epic", "p-acc", null],
    [q.stories, "User stories", "Récits utilisateur", "story", "p-acc", null],
    [q.taches, "Tâches", "Unités de travail", "task", "p-acc", null],
    [toutesLesTaches().length, "Tâches du projet", "Nombre total de tâches", "task", "p-acc", null],
    [anc + " %", "Tâches sourcées", "Preuve rattachée", "anc", anc >= 70 ? "p-ok" : "p-warn", anc],
    [couv + " %", "Couverture du besoin", "Fonctionnalités traitées", "couv", couv >= 70 ? "p-ok" : "p-warn", couv],
    [p.documents, "Documents collectés", "Après sélection", "doc", "p-neu", null]
  ];
  $("#kpis").innerHTML = kpis.map(([v, l, s, ico, cls, barre]) => `
    <div class="kpi">
      <div class="haut">
        <div class="v">${v == null || v === "" ? "—" : esc(typeof v === "number" ? nf(v) : v)}</div>
        <div class="puce ${cls}">${ICO[ico]}</div>
      </div>
      <div class="l">${esc(l)}</div>
      <div class="s">${esc(s)}</div>
      ${barre == null ? "" : `<div class="mini"><i style="width:${barre}%"></i></div>`}
    </div>`).join("");

  const avert = textes(META.avertissements);
  $("#zoneAvert").innerHTML = avert.length ? `
    <div class="alerte avert" style="margin:0 0 16px">${ICO.alerte}
      <div><b>Points signalés par la validation finale (${avert.length})</b>
      ${avert.map(x => `• ${esc(x)}`).join("<br>")}</div></div>` : "";

  const ligne = (k, v) => (v && String(v).trim())
    ? `<div class="prop"><dt>${esc(k)}</dt><dd>${String(v).includes("<") ? v : esc(v)}</dd></div>` : "";
  const enChips = arr => textes(arr).length
    ? `<div class="chips">${textes(arr).map(x => `<span class="chip">${esc(x)}</span>`).join("")}</div>` : "—";

  $("#propsCadrage").innerHTML =
      ligne("Objectif", a.objectif)
    + ligne("Intention", a.intention)
    + ligne("Domaine", a.domaine)
    + ligne("Public visé", enChips(a.utilisateurs))
    + ligne("Contraintes", enChips(a.contraintes))
    + ligne("Concepts clés", enChips(a.concepts))
    || `<p class="vide">Cadrage non disponible.</p>`;

  /* anneau des types */
  const parType = compteParType();
  const total = Object.values(parType).reduce((s, v) => s + v, 0);
  const r = 46, c = 2 * Math.PI * r;
  let offset = 0, segments = "";
  Object.entries(parType).sort((x, y) => y[1] - x[1]).forEach(([k, n]) => {
    const part = n / total, len = c * part;
    segments += `<circle cx="56" cy="56" r="${r}" fill="none" stroke="${COUL_TYPE[k] || "#94a3b8"}"
      stroke-width="13" stroke-dasharray="${len - 1.5} ${c - len + 1.5}"
      stroke-dashoffset="${-offset}" transform="rotate(-90 56 56)"/>`;
    offset += len;
  });
  $("#anneau").innerHTML = `<svg width="112" height="112" viewBox="0 0 112 112">
      <circle cx="56" cy="56" r="${r}" fill="none" stroke="#f1f3f9" stroke-width="13"/>${segments}</svg>
    <div class="cent"><b>${nf(total)}</b><span>Tâches</span></div>`;
  $("#noteCharge").textContent = `${Object.keys(parType).length} natures de travail`;
  $("#legendeTypes").innerHTML = Object.entries(parType).sort((x, y) => y[1] - x[1])
    .map(([k, n]) => `<div class="l"><i style="background:${COUL_TYPE[k] || "#94a3b8"}"></i>
      ${esc(typeLib(k))}<b>${nf(n)}</b></div>`).join("") ||
    `<p class="vide">Aucune tâche.</p>`;

  /* Nombre de tâches par épic */
  const epics = PLAN.epics || [];
  const maxTaches = Math.max(1, ...epics.map(tachesEpic));
  const sommeTaches = epics.reduce((s, e) => s + tachesEpic(e), 0);
  $("#noteEpics").textContent = `${nf(sommeTaches)} tâches au total`;
  $("#charges").innerHTML = epics.length ? epics.map(e => `
    <div class="bar-l">
      <div class="n">${esc(e.title)}</div>
      <div class="v">${nf(tachesEpic(e))} tâche(s)</div>
      <div class="bar-t"><i style="width:${(tachesEpic(e) / maxTaches * 100).toFixed(1)}%"></i></div>
    </div>`).join("") : `<p class="vide">Aucun épic.</p>`;

  /* priorités */
  const pr = compteParPriorite(), tp = Object.values(pr).reduce((s, v) => s + v, 0) || 1;
  const COUL_PR = {"Haute":"#e11d48", "Moyenne":"#f59e0b", "Basse":"#94a3b8"};
  $("#pilePriorites").innerHTML = Object.entries(pr)
    .map(([k, n]) => n ? `<i style="width:${n / tp * 100}%;background:${COUL_PR[k]}" title="${k}"></i>` : "")
    .join("");
  $("#legendePriorites").innerHTML = Object.entries(pr)
    .map(([k, n]) => `<div class="l"><i style="background:${COUL_PR[k]}"></i>Priorité ${k.toLowerCase()}
      <b>${nf(n)} · ${Math.round(n / tp * 100)} %</b></div>`).join("");

  /* fonctionnalités */
  const cats = META.categories_fonctionnalites || {};
  const nb = Object.values(cats).reduce((s, v) => s + v, 0);
  $("#noteFonctions").textContent = `${nb} fonctionnalité${nb > 1 ? "s" : ""} retenue${nb > 1 ? "s" : ""} sur ${p.fonctions_brutes || "—"} énoncés bruts`;
  const fac = textes(a.fonctionnalites);
  $("#fonctionnalites").innerHTML = fac.length
    ? fac.map(f => `<span class="chip acc">${esc(f)}</span>`).join("")
    : `<p class="vide">Aucune fonctionnalité isolée par l'analyse.</p>`;
}

/* ── vue : backlog ───────────────────────────────────────────────── */
function correspond(t, s, e){
  if(FILTRE_TYPE && (t.type || "dev") !== FILTRE_TYPE) return false;
  if(!Q) return true;
  const q = Q.toLowerCase();
  return [t.title, t.description, t.cle, s.title, e.title, s.i_want]
    .some(x => String(x || "").toLowerCase().includes(q));
}

function rendreBacklog(){
  const epics = PLAN.epics || [];
  let vus = 0;
  const html = epics.map((e, i) => {
    const stories = (e.stories || []).map((s, j) => {
      const tasks = (s.tasks || []).filter(t => correspond(t, s, e));
      if(!tasks.length) return "";
      vus += tasks.length;
      const nombreTaches = tasks.length;
      return `<div class="story">
        <div class="story-tete">
          <span class="cle">${esc(s.cle || ("US-" + (i + 1) + "." + (j + 1)))}</span>
          <span class="story-titre">${esc(s.title)}</span>
          <span class="story-pts">${nf(nombreTaches)} tâche(s)</span>
        </div>
        <p class="recit"><b>En tant que</b> ${esc(s.as_a || "utilisateur")}, <b>je veux</b>
          ${esc(s.i_want || s.title)}, <b>afin de</b> ${esc(s.so_that || "—")}.</p>
        ${(s.acceptance || []).length ? `<div class="criteres">
          <div class="cl">Critères d'acceptation</div>
          ${(s.acceptance || []).map(x => `<div class="c">${ICO.ok}<span>${esc(x)}</span></div>`).join("")}
        </div>` : ""}
        <div class="table-enveloppe"><table>
          <thead><tr><th style="width:82px">Clé</th><th>Tâche</th>
            <th style="width:124px">Nature</th><th style="width:92px">Priorité</th>
            <th style="width:125px">Complexité</th><th style="width:88px">Preuve</th></tr></thead>
          <tbody>${tasks.map(t => `<tr class="ligne-clic" onclick="ouvrirTache('${esc(t.cle)}')">
            <td><span class="cle">${esc(t.cle)}</span></td>
            <td><div class="t-titre">${esc(t.title)}</div>
              ${t.description ? `<div class="t-desc">${esc(t.description)}</div>` : ""}</td>
            <td><span class="etq ${esc(t.type || "dev")}">${esc(typeLib(t.type))}</span></td>
            <td><span class="etq pr-${esc(String(t.priorite || "").toLowerCase())}">${esc(t.priorite || "—")}</span></td>
            <td><span class="complexite">${esc(t.complexite_classe || "Non classée")}</span></td>
            <td>${(t.sources || []).map(x => `<a class="src" href="#p${x}"
                  onclick="voirPreuve(${Number(x)});return false">${esc(x)}</a>`).join("") ||
                 `<span class="vide">—</span>`}</td>
          </tr>`).join("")}</tbody></table></div>
      </div>`;
    }).join("");

    if(!stories) return "";
    const ouv = TOUT_OUVERT || (i === 0 && !Q && !FILTRE_TYPE);
    return `<div class="epic ${ouv ? "ouvert" : ""}">
      <div class="epic-tete">
        <span class="epic-num">${i + 1}</span>
        <span class="epic-nom"><b>${esc(e.title)}</b>
          <span>${esc(e.description || "")}</span></span>
        <span class="epic-meta">
          <span class="t">${(e.stories || []).length} stories</span>
          <span class="t">${nf(tachesEpic(e))} tâches</span>
        </span>
        <svg class="chev" viewBox="0 0 16 16" fill="none" stroke="currentColor"
             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3.5 10.5 8 6 12.5"/></svg>
      </div>
      <div class="epic-corps">
        ${e.description ? `<div class="epic-desc">${esc(e.description)}</div>` : ""}
        ${stories}
      </div>
    </div>`;
  }).join("");

  $("#listeEpics").innerHTML = html || `<div class="carte"><div class="carte-corps">
    <p class="vide">Aucune tâche ne correspond à la recherche.</p></div></div>`;
  $("#titreBacklog").innerHTML = `Backlog<span style="margin-left:8px">${nf(vus)} tâche${vus > 1 ? "s" : ""} affichée${vus > 1 ? "s" : ""} sur ${nf(toutesLesTaches().length)}</span>`;
  $$(".epic-tete").forEach(t => t.onclick = () => t.parentElement.classList.toggle("ouvert"));
}

/* ── vue : tableau ───────────────────────────────────────────────── */
function rendreTableau(){
  const g = {dev:[], design:[], config:[], test:[], doc:[], securite:[]};
  toutesLesTaches().forEach(x => {
    if(!correspond(x.t, x.story, x.epic)) return;
    (g[x.t.type] || g.dev).push(x);
  });
  const colonnes = [
    ["Développement", g.dev],
    ["Conception & configuration", [...g.design, ...g.config]],
    ["Tests", g.test],
    ["Documentation", g.doc],
    ["Sécurité", g.securite]
  ];
  $("#tableau").innerHTML = colonnes.map(([nom, cartes]) => `
    <div class="col">
      <div class="col-tete"><b>${esc(nom)}</b><span>${cartes.length}</span></div>
      ${cartes.map(({t, epic}) => `
        <div class="carte-k" onclick="ouvrirTache('${esc(t.cle)}')">
          <div class="kt">${esc(t.title)}</div>
          <div class="kl">
            <span class="etq ${esc(t.type || "dev")}">${esc(typeLib(t.type))}</span>
            <span class="complexite">${esc(t.complexite_classe || "Non classée")}</span>
            <span>·</span><span>${esc(t.cle)}</span>
          </div>
          <div class="ke">${esc(epic.title)}</div>
        </div>`).join("") || `<div class="col-vide">Aucune tâche</div>`}
    </div>`).join("");
  const n = Object.values(g).reduce((s, a) => s + a.length, 0);
  $("#titreTableau").innerHTML = `Tableau<span style="margin-left:8px">${nf(n)} tâche${n > 1 ? "s" : ""} répartie${n > 1 ? "s" : ""} par nature</span>`;
}


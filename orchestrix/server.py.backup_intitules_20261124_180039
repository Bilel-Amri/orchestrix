function ajouterMembre(){
  window._equipe.push({nom:"", role:(PROJET.roles || ["Développeur backend"])[0]});
  dessinerEquipe();
}
function fermerEquipe(){ const e = $("#panneauEquipe"); if(e) e.remove(); }

async function enregistrerEquipe(){
  const membres = window._equipe.filter(m => (m.nom || "").trim());
  try {
    adopter(await API.poster("/api/projet/equipe", {membres}));
    fermerEquipe();
  } catch(e){ alert("Erreur : " + e.message); }
}

/* ── vue : exécution ─────────────────────────────────────────────── */
function rendreExecution(){
  const st = (PROJET && PROJET.statistiques) || {};
  const toutes = (PROJET && PROJET.taches) || [];
  const eq = ((PROJET && PROJET.projet) || {}).equipe || [];
  const statuts = (PROJET && PROJET.statuts) || [];

  /* bandeau de synthèse */
  const parS = st.par_statut || {};
  $("#execResume").innerHTML = `
    <div class="resume-item"><b>${st.avancement || 0} %</b><span>avancement</span></div>
    ${statuts.map(s => `<div class="resume-item"><b>${nf(parS[s.cle] || 0)}</b>
       <span>${esc(s.libelle)}</span></div>`).join("")}
    <div class="resume-item"><b>${nf(st.non_assigne || 0)}</b><span>sans responsable</span></div>
    <div class="resume-item"><b>${nf(parS.termine || 0)}/${nf(st.total || 0)}</b>
      <span>tâches terminées</span></div>`;

  /* filtre par membre */
  $("#execMembres").innerHTML = `
    <button class="puce-membre ${FILTRE_EXEC === "" ? "on" : ""}" onclick="filtrerExec('')">
      Toute l'équipe</button>` + eq.map(m => `
    <button class="puce-membre ${FILTRE_EXEC === m.id ? "on" : ""}"
            onclick="filtrerExec('${esc(m.id)}')">
      <span class="avatar petit">${esc(m.initiales)}</span>${esc(m.nom)}</button>`).join("");

  const filtre = toutes.filter(t => {
    if(FILTRE_EXEC && t.assigne !== FILTRE_EXEC) return false;
    if(RECHERCHE_EXEC){
      const q = RECHERCHE_EXEC.toLowerCase();
      if(!(t.titre + " " + t.cle + " " + t.epic_titre).toLowerCase().includes(q)) return false;
    }
    return true;
  });

  $("#tableExec").innerHTML = filtre.length ? `<table>
    <thead><tr>
      <th style="width:84px">Clé</th><th>Tâche</th>
      <th style="width:150px">Responsable</th>
      <th style="width:112px">Statut</th>
      <th style="width:125px">Complexité</th>
      <th style="width:76px">Jira</th>
    </tr></thead>
    <tbody>${filtre.map(t => {
      const m = eq.find(x => x.id === t.assigne);
      return `<tr>
        <td><span class="cle">${esc(t.cle)}</span></td>
        <td><div class="t-titre ligne-clic" onclick="ouvrirTacheExec('${esc(t.cle)}')">
              ${esc(t.titre)}</div>
            <div class="t-desc">${esc(t.epic_titre)} · ${esc(t.story)}</div></td>
        <td>${m ? `<span class="qui"><span class="avatar petit">${esc(m.initiales)}</span>
              ${esc(m.nom)}</span>` : `<span class="vide">non affectée</span>`}</td>
        <td>${selecteurStatut(t)}</td>
        <td><span class="complexite">${esc(t.complexite_classe || "Non classée")}</span></td>
        <td>${t.jira ? `<span class="cle" style="background:var(--olive-clair);
              color:var(--olive);border-color:var(--olive)">${esc(t.jira)}</span>`
            : `<span class="vide">—</span>`}</td>
      </tr>`;
    }).join("")}</tbody></table>`
    : `<div class="carte-corps"><p class="vide">${toutes.length
        ? "Aucune tâche ne correspond au filtre."
        : "Aucune tâche : créez le projet depuis la synthèse."}</p></div>`;
}

function selecteurStatut(t){
  const statuts = (PROJET && PROJET.statuts) || [];
  return `<select class="sel-statut s-${esc(t.statut)}"
      onchange="changerStatut('${esc(t.cle)}', this.value)">
    ${statuts.map(s => `<option value="${s.cle}" ${s.cle === t.statut ? "selected" : ""}>
      ${esc(s.libelle)}</option>`).join("")}
  </select>`;
}

function filtrerExec(id){ FILTRE_EXEC = id; rendreExecution(); }

async function changerStatut(cle, statut){
  try { adopter(await API.poster("/api/projet/statut", {cle, statut})); }

/* ══════════════════════════════════════════════════════════════════════
   ESPACE DE TRAVAIL — projet, équipe, exécution, Jira
   ══════════════════════════════════════════════════════════════════════ */
let PROJET = null;          // état renvoyé par /api/projet
let FILTRE_EXEC = "";       // filtre par membre
let RECHERCHE_EXEC = "";

const API = {
  async lire(url) {
    const r = await fetch(url);
    return r.json();
  },
  async poster(url, corps) {
    const r = await fetch(url, {
      method: "POST", headers: {"Content-Type": "application/json"},
      body: JSON.stringify(corps || {})});
    const d = await r.json().catch(() => ({erreur: "réponse illisible"}));
    if(!r.ok) throw new Error(d.erreur || ("erreur " + r.status));
    return d;
  }
};

function adopter(d){
  if(d && d.etat) d = d.etat;
  PROJET = d;
  rendreEspace();
  rendreExecution();
  rendreJira();
  rendreValidation();
}

async function chargerProjet(){
  try {
    const d = await API.lire("/api/projet");
    PROJET = d;
    rendreEspace(); rendreExecution(); rendreJira(); rendreValidation();
  } catch(e) { /* serveur ancien : la plateforme reste vide */ }
}

/* ── vue : espace de travail ─────────────────────────────────────── */
function rendreEspace(){
  const p = PROJET && PROJET.projet;
  const st = (PROJET && PROJET.statistiques) || {};
  if(!p){
    $("#espaceVide").classList.remove("cache");
    $("#espacePlein").classList.add("cache");
    return;
  }
  $("#espaceVide").classList.add("cache");
  $("#espacePlein").classList.remove("cache");

  $("#eSujet").textContent = p.nom;
  $("#eObjectif").textContent = p.objectif || p.brief || "";
  $("#eMeta").textContent = [p.domaine, "créé le " + p.cree_le].filter(Boolean).join(" · ");
  $("#eKpi").innerHTML = [
    [st.avancement + " %", "Avancement", "tâches terminées", "p-ok", st.avancement],
    [st.total, "Tâches", (st.en_cours || 0) + " en cours", "p-acc", null],
    [st.bloquees, "Bloquées", "à débloquer", st.bloquees ? "p-warn" : "p-neu", null],
    [(p.equipe || []).length, "Membres", "dans l'équipe", "p-acc", null],
    [st.non_assigne, "Non affectées", "sans responsable", st.non_assigne ? "p-warn" : "p-ok", null],
    [(st.par_statut || {}).termine || 0, "Tâches terminées",
     "sur " + (st.total || 0) + " tâches", "p-ok", st.avancement || 0]
  ].map(([v, l, s, c, barre]) => `
    <div class="kpi"><div class="haut">
      <div class="v">${typeof v === "number" ? nf(v) : esc(v)}</div>
      <div class="puce ${c}">${ICO.task}</div></div>
      <div class="l">${esc(l)}</div><div class="s">${esc(s)}</div>
      ${barre == null ? "" : `<div class="mini"><i style="width:${barre}%"></i></div>`}
    </div>`).join("");

  /* avancement par épic */
  const parEpic = {};
  (PROJET.taches || []).forEach(t => {
    const e = parEpic[t.epic] = parEpic[t.epic] || {titre: t.epic_titre, total: 0, fait: 0};
    e.total++;
    if(t.statut === "termine") e.fait++;
  });
  const lignes = Object.entries(parEpic);
  $("#eAvancement").innerHTML = lignes.length ? lignes.map(([id, e]) => {
    const pc = Math.round(e.fait / e.total * 100);
    return `<div class="bar-l">
      <div class="n"><b style="font-weight:600">${esc(e.titre)}</b>
        <span class="vide" style="margin-left:6px">${e.fait}/${e.total}</span></div>
      <div class="v">${pc} %</div>
      <div class="bar-t"><i style="width:${pc}%"></i></div></div>`;
  }).join("") : `<p class="vide">Aucune tâche.</p>`;

  /* équipe */
  $("#eEquipe").innerHTML = (p.equipe || []).length ? (p.equipe || []).map(m => {
    const c = (st.equipe || []).find(x => x.nom === m.nom) || {};
    const pc = c.taches ? Math.round((c.terminees || 0) / c.taches * 100) : 0;
    return `<div class="membre">
      <span class="avatar">${esc(m.initiales)}</span>
      <span class="infos"><b>${esc(m.nom)}</b><span>${esc(m.role)}</span></span>
      <span class="chg">
        <span class="taux">${c.terminees || 0} / ${c.taches || 0} tâches terminées</span>
        <span class="jauge"><i style="width:${pc}%"></i></span>
      </span>
    </div>`;
  }).join("") : `<p class="vide">Aucun membre. Ajoutez l'équipe pour affecter les tâches.</p>`;
  $("#bEquipe").textContent = (p.equipe || []).length || "";
  $("#bExec").textContent = st.total || "";
  majSelectMembres();
}

function majSelectMembres(){
  const p = PROJET && PROJET.projet;
  const sel = $("#affMembre");
  if(!sel || !p) return;
  const garde = sel.value;
  sel.innerHTML = `<option value="">Personne</option>` +
    (p.equipe || []).map(m => `<option value="${esc(m.id)}">${esc(m.nom)}</option>`).join("");
  sel.value = garde;
}

/* ── équipe : dialogue d'édition ─────────────────────────────────── */
function ouvrirEquipe(){
  if(!PROJET || !PROJET.projet){ alert("Créez d'abord le projet."); return; }
  const membres = (PROJET.projet.equipe || []).slice();
  const roles = (PROJET.roles || []);
  const html = `
    <div class="voile" onclick="fermerEquipe()"></div>
    <aside class="panneau" role="dialog" aria-modal="true" aria-label="Équipe du projet"

# 6. API FASTAPI SANS AUTHENTIFICATION
# ============================================================

app = FastAPI(
    title="PlanAgent API",
    version="2.2.0",
    description="Classification textuelle des tâches."
)


class Tache(BaseModel):

    title: str = Field(
        default="",
        max_length=500
    )

    body: str = Field(
        default="",
        max_length=10000
    )


class RequeteLot(BaseModel):

    taches: list[Tache] = Field(
        min_length=1,
        max_length=100
    )


@app.get("/")
def racine():

    return {
        "service": "PlanAgent",
        "version": "2.2.0",
        "authentification": False,
        "documentation": "/docs"
    }


@app.get("/health")
def health():

    return {
        "status": "ok",
        "service": "PlanAgent",
        "modele": "charge",
        "actif": True,
        "version": "2.2.0",
        "classes": sorted(CLASSES_AUTORISEES)
    }


@app.post("/predire")
def predire(tache: Tache):

    try:

        resultat = predict_planagent(
            tache.title,
            tache.body
        )

        return {
            "complexite_classe": resultat["complexity"],
            "origine": "modele",
            "latence_ms": round(
                resultat["processing_time_seconds"] * 1000,
                2
            ),
            "scores": resultat["scores"]
        }

    except Exception as e:

        raise HTTPException(
            status_code=500,
            detail=str(e)
        )


@app.post("/predire_lot")
def predire_lot(requete: RequeteLot):

    predictions = []

    debut = time.perf_counter()

    try:

        for tache in requete.taches:

            resultat = predict_planagent(
                tache.title,
                tache.body
            )

            predictions.append({
                "complexite_classe": resultat["complexity"]
            })

        return {
            "predictions": predictions,
            "modele": {
                "version": "2.2.0"
            },
            "nombre_taches": len(predictions),
            "latence_ms": round(
                (time.perf_counter() - debut) * 1000,
                2
            )
        }

    except Exception as e:

        raise HTTPException(
            status_code=500,
            detail=str(e)
        )



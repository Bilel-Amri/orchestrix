# 4. CARACTERISTIQUES TEXTUELLES
# ============================================================

def meta_features(df):

    t = df["title"].fillna("").astype(str)
    b = df["body"].fillna("").astype(str)

    tb = (t + " " + b).str.lower()

    f = pd.DataFrame(index=df.index)

    f["t_len"] = np.log1p(t.str.len())
    f["t_words"] = np.log1p(
        t.str.split().str.len()
    )

    f["b_len"] = np.log1p(b.str.len())
    f["b_words"] = np.log1p(
        b.str.split().str.len()
    )

    f["b_lines"] = np.log1p(
        b.str.count("\n")
    )

    f["has_body"] = (
        b.str.strip() != ""
    ).astype(float)

    f["has_code"] = b.str.contains(
        r"\{code|\{noformat|```|Exception|Traceback",
        regex=True
    ).astype(float)

    f["n_urls"] = np.log1p(
        b.str.count(r"http")
    )

    f["n_bullets"] = np.log1p(
        b.str.count(r"(?m)^\s*[\*\-#]")
    )

    f["n_questions"] = np.log1p(
        b.str.count(r"\?")
    )

    f["n_and"] = np.log1p(
        tb.str.count(r"\band\b")
    )

    return f.values.astype(np.float32)


# ============================================================
# 5. FONCTION DE PREDICTION
# ============================================================

def predict_planagent(title, body=""):

    debut = time.perf_counter()

    title = str(title or "").strip()
    body = str(body or "").strip()

    if not title and not body:
        raise ValueError(
            "Titre et description vides."
        )

    texte = (
        "Title: " + title +
        " Description: " + body
    )

    df = pd.DataFrame([{
        "title": title,
        "body": body
    }])

    M = scaler.transform(
        meta_features(df)
    )

    Xw = word_vec.transform([texte])
    Xc = char_vec.transform([texte])

    X = hstack(
        [Xw, Xc, csr_matrix(M)],
        format="csr"
    )

    X_sparse = hstack(
        [Xw, Xc],
        format="csr"
    )

    G = np.hstack([
        svd.transform(X_sparse),
        M
    ])

    E = st_model.encode(
        [texte],
        batch_size=1,
        normalize_embeddings=True,
        convert_to_numpy=True,
        show_progress_bar=False
    )

    Z = np.hstack([E, M])

    probabilities = [
        lr.predict_proba(X),
        sgd.predict_proba(X),
        hgb.predict_proba(G),
        emb_lr.predict_proba(Z)
    ]

    P = np.mean(
        probabilities,
        axis=0
    )[0]

    P = P * CLASS_WEIGHTS

    total = P.sum()

    if total <= 0 or not np.isfinite(total):
        raise RuntimeError(
            "Probabilités invalides."
        )

    P = P / total

    class_id = int(np.argmax(P))

    classe = CLASS_NAMES[class_id]

    if classe not in CLASSES_AUTORISEES:
        raise RuntimeError(
            "Classe non autorisée."
        )

    return {
        "class_id": class_id,
        "complexity": classe,
        "scores": {
            CLASS_NAMES[i]: round(
                float(P[i]), 6
            )
            for i in range(len(P))
        },
        "processing_time_seconds": round(
            time.perf_counter() - debut,
            4
        )
    }



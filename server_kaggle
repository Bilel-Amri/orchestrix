print("\n[8/9] Préparation de Cloudflare...")

binary = "/usr/local/bin/cloudflared"

if not os.path.exists(binary):

    subprocess.run(
        [
            "wget",
            "-q",
            "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64",
            "-O",
            binary
        ],
        check=True
    )

    os.chmod(binary, 0o755)

subprocess.run(
    [binary, "--version"],
    check=True
)

log_file = "/kaggle/working/cloudflared.log"

cloudflare_log = open(
    log_file,
    "w"
)

cloudflared_process = subprocess.Popen(
    [
        binary,
        "tunnel",
        "--no-autoupdate",
        "--url",
        LOCAL_URL
    ],
    stdout=cloudflare_log,
    stderr=subprocess.STDOUT
)

public_url = None
tunnel_connected = False

for _ in range(90):

    if cloudflared_process.poll() is not None:
        break

    time.sleep(1)

    with open(log_file, "r") as f:
        logs = f.read()

    match = re.search(
        r"https://[a-zA-Z0-9-]+\.trycloudflare\.com",
        logs
    )

    if match:
        public_url = match.group(0)

    if public_url and re.search(
        r"Registered tunnel connection|Connection .* registered",
        logs,
        re.IGNORECASE
    ):
        tunnel_connected = True
        break

if not public_url:

    raise RuntimeError(
        "Cloudflare n'a pas généré d'URL.\n" +
        logs[-5000:]
    )

print("URL Cloudflare :", public_url)

if not tunnel_connected:
    print(
        "Connexion du tunnel non encore confirmée."
    )

